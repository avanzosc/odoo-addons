<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='move_ids_without_package']/tree/field[@name='description_picking']"
        position="after"
      >
                <field
          name="date_arrival_supplier_material"
          optional="show"
          widget="date"
        />
            </xpath>
            <xpath
        expr="//field[@name='move_ids_without_package']/form//field[@name='description_picking']"
        position="after"
      >
                <field name="date_arrival_supplier_material" widget="date" />
            </xpath>
        </field>
    </record>
</odoo>
