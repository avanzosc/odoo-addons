<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_move_line_kanban" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_kanban" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="delete">1</attribute>
      </kanban>
      <xpath expr="//t[@t-name='card']/div[1]" position="before">
        <a
          t-if="! read_only_mode"
          type="delete"
          style="position: absolute; right: 0; padding: 4px; display: inline-block"
        >X</a>
      </xpath>
      <xpath expr="//div[@groups='stock.group_production_lot']" position="replace">
        <div
          groups="stock.group_production_lot"
          invisible="not lot_id and not lot_name"
        >
                    Lot:
                    <field name="lot_id" invisible="not lot_id and lot_name" />
                    <field name="lot_name" invisible="lot_id or not lot_name" />
                </div>
      </xpath>
      <xpath expr="//field[@name='product_uom_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='quantity']" position="replace">
        <div>
          <span>
                        Quantity:
                        <field name="quantity" />
                        <field name="product_uom_id" groups="uom.group_uom" />
                    </span>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
