<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="stock_config_settings_form_view" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="stock.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//block[@name='operations_setting_container']" position="inside">
        <setting
          id="detailed_operations_visible"
          help="Detailed operations always visible."
        >
          <field name="group_detailed_operations_visible" />
        </setting>
      </xpath>
    </field>
  </record>
</odoo>
