<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="external_layout_background" inherit_id="web.external_layout_background">
        <div t-field="company.report_footer" position="replace">
            <div t-if="o and o._name in ['account.invoice','sale.order','stock.picking']" class="list-inline-item row">
                <div class="col-10">
                    <div t-field="company.report_footer"/>
                </div>
                <div class="col-2" t-if="o.is_fsc_certificate">
                    <img t-if="o.company_id.fsc_certificate_image"
     t-att-src="image_data_uri(o.company_id.fsc_certificate_image)"
     style="max-width:80px;"
     alt="FSC certificate"/>

                </div>
            </div>
            <t t-else="">
                <div t-field="company.report_footer"/>
            </t>
        </div>
    </template>
</odoo>
