<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_sale_payment_mode" inherit_id="sale.report_saleorder_document">
        <xpath expr="//td[@name='td_name']" position="inside">
            <span class="ml-2" t-if="line.product_id.is_fsc_certificate"> *</span>
        </xpath>
        <xpath expr="//div[@t-if='doc.signature']" position="after">
            <t t-if="doc.is_fsc_certificate">
                <div t-if="doc.company_id.fsc_certificate_number">
                    <img t-att-src="image_data_uri(doc.company_id.fsc_certificate_image)"
                         style="max-width:80px;"
                         alt="FSC certificate"
                         t-if="doc.company_id.fsc_certificate_image"
                    />
                    <p>
                        [*] Only the products that are identified as such in this document are FSC ® MIX Certified. FSC certificate number: <span t-field="doc.company_id.fsc_certificate_number" />
                    </p>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
