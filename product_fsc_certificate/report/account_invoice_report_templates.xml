<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']" position="inside">
            <span class="ml-2" t-if="line.product_id.is_fsc_certificate"> *</span>
        </xpath>
        <xpath expr="//div[@id='qrcode']" position="before">
            <t t-if="o.is_fsc_certificate" >
                <div t-if="o.company_id.fsc_certificate_number">
                    <p>
                        [*] Only the products that are identified as such in this document are FSC ® MIX Certified. FSC certificate number: <span t-field="o.company_id.fsc_certificate_number" />
                    </p>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
