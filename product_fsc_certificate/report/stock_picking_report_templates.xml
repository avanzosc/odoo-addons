<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <xpath expr="//span[@t-field='move_line.product_id']/.." position="inside">
            <span class="ml-2" t-if="move_line.product_id.is_fsc_certificate"> *</span>
        </xpath>
        <xpath expr="//table[@t-if=&quot;o.move_line_ids and o.state=='done'&quot;]" position="after">
            <t t-if="o.is_fsc_certificate">
            <div t-if="o.company_id.fsc_certificate_number">
                <img t-att-src="image_data_uri(o.company_id.fsc_certificate_image)"
                     style="max-width:80px;"
                     alt="FSC certificate"
                     t-if="o.company_id.fsc_certificate_image"
                />
                <p>
                    [*] Only the products that are identified as such in this document are FSC ® MIX Certified. FSC certificate number: <span t-field="o.company_id.fsc_certificate_number" />
                </p>
            </div>
            </t>
        </xpath>
    </template>

    <template id="report_picking" inherit_id="stock.report_picking">
        <span t-field="ml.product_id.description_picking" position="after">
            <span class="ml-2" t-if="ml.product_id.is_fsc_certificate"> *</span>
        </span>
        <xpath expr="//p[@t-field='o.note']" position="after">
            <t t-if="o.is_fsc_certificate">
            <div t-if="o.company_id.fsc_certificate_number">
                <img t-att-src="image_data_uri(o.company_id.fsc_certificate_image)"
                     style="max-width:80px;"
                     alt="FSC certificate"
                     t-if="o.company_id.fsc_certificate_image"/>
                <p>
                    [*] Only the products that are identified as such in this document are FSC ® MIX Certified. FSC certificate number: <span t-field="o.company_id.fsc_certificate_number" />
                </p>
            </div>
            </t>
        </xpath>
    </template>
</odoo>
