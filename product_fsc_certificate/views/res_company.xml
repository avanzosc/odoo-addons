<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_fsc_certificate" model="ir.ui.view">
        <field name="name">res.company.form.fsc.certificate</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="FSC Certificate" name="fsc_certificate">
                    <group string="FSC Certification">
                        <field name="fsc_certificate_image" widget="image" />
                        <field name="fsc_certificate_number" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
