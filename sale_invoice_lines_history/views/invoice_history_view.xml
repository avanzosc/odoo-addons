<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_invoice_history_tree" model="ir.ui.view">
    <field name="model">invoice.history</field>
    <field name="arch" type="xml">
      <list string="Invoice History" create="0" edit="0" delete="0">
        <field name="number" />
        <field name="name" />
        <field name="reference" />
        <field name="date_invoice" />
        <field name="partner" />
        <field name="type" />
      </list>
    </field>
  </record>
  <record id="view_invoice_history_form" model="ir.ui.view">
    <field name="model">invoice.history</field>
    <field name="arch" type="xml">
      <form string="Invoce History" create="0" edit="0" delete="0">
        <group colspan="4" col="4">
          <field name="number" />
          <field name="name" />
          <field name="reference" />
          <field name="internal_number" />
          <field name="partner" invisible="not partner" />
          <field name="partner_id" invisible="partner" />
          <field name="amount_tax" />
          <field name="amount_untaxed" />
          <field name="amount_total" />
          <field name="type" />
          <field name="move_name" />
          <field name="account" />
          <field name="journal" />
          <field name="date_invoice" />
          <field name="date_due" />
          <field name="comment" />
        </group>
        <field name="history_lines" />
      </form>
    </field>
  </record>
  <record id="view_invoice_history_pivot" model="ir.ui.view">
    <field name="model">invoice.history</field>
    <field name="arch" type="xml">
      <pivot string="Invoice History">
        <field name="partner_id" type="row" />
        <field name="type" type="row" />
        <field name="date_invoice" type="col" interval="month" />
        <field name="amount_tax" type="measure" />
        <field name="amount_untaxed" type="measure" />
        <field name="amount_total" type="measure" />
      </pivot>
    </field>
  </record>

  <record id="invoice_history_filter" model="ir.ui.view">
    <field name="model">invoice.history</field>
    <field name="arch" type="xml">
      <search string="Search Invoice History">
        <field name="number" />
        <field name="type" />
        <group expand="0" string="Group By">
          <filter
            string="Invoice Number"
            name="number"
            domain="[]"
            context="{'group_by':'number'}"
          />
          <filter
            string="Partner"
            name="partner_id"
            domain="[]"
            context="{'group_by':'partner_id'}"
          />
          <filter
            string="Date"
            name="date_invoice"
            domain="[]"
            context="{'group_by':'date_invoice'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="invoice_history_customer_act" model="ir.actions.act_window">
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">invoice.history</field>
    <field name="view_mode">list,pivot,form</field>
    <field
      name="domain"
    >['|',('type','=','out_invoice'),('type','=','out_refund')]</field>
    <field name="view_id" ref="view_invoice_history_tree" />
  </record>

  <record id="invoice_history_supplier_act" model="ir.actions.act_window">
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">invoice.history</field>
    <field name="view_mode">list,pivot,form</field>
    <field
      name="domain"
    >['|',('type','=','in_invoice'),('type','=','in_refund')]</field>
    <field name="context">{'type': 'in_invoice'}</field>
    <field name="view_id" ref="view_invoice_history_tree" />
  </record>

  <record id="view_invoice_line_history_tree" model="ir.ui.view">
    <field name="model">invoice.move.line.history</field>
    <field name="arch" type="xml">
      <list
        string="Invoice Move Lines"
        create="0"
        edit="0"
        delete="0"
        default_order="partner nulls last, invoice_id, product"
      >
        <field name="name" />
        <field name="product" />
        <field name="quantity" string="Qty" />
        <field name="price_unit" />
        <field name="discount" />
      </list>
    </field>
  </record>

  <record id="view_invoice_line_history_menu_tree" model="ir.ui.view">
    <field name="model">invoice.move.line.history</field>
    <field name="priority" eval="20" />
    <field name="arch" type="xml">
      <list
        string="Invoice Lines"
        create="0"
        edit="0"
        delete="0"
        default_order="partner nulls last, invoice_id, product"
      >
        <field name="invoice_id" />
        <field name="partner" />
        <field name="name" />
        <field name="product" />
        <field name="quantity" string="Qty" />
        <field name="price_unit" />
        <field name="price_subtotal" />
        <field name="discount" />
      </list>
    </field>
  </record>

  <record id="view_invoice_line_history_form" model="ir.ui.view">
    <field name="model">invoice.move.line.history</field>
    <field name="priority" eval="20" />
    <field name="arch" type="xml">
      <form string="Invoice Lines" create="0" edit="0" delete="0">
        <group>
          <field name="invoice_id" />
          <field name="partner" />
          <field name="name" />
          <field name="product" />
          <field name="quantity" string="Qty" />
          <field name="price_unit" />
          <field name="price_subtotal" />
          <field name="discount" />
        </group>
      </form>
    </field>
  </record>
  <record id="view_invoice_line_history_pivot" model="ir.ui.view">
    <field name="model">invoice.move.line.history</field>
    <field name="arch" type="xml">
      <pivot string="Invoice Lines">
        <field name="invoice_id" type="row" />
        <field name="partner_id" type="row" />
        <field name="product" type="row" />
        <field name="quantity" type="measure" />
        <field name="price_unit" type="measure" />
        <field name="price_subtotal" type="measure" />
        <field name="discount" type="measure" />
      </pivot>
    </field>
  </record>

  <record id="invoice_line_history_filter" model="ir.ui.view">
    <field name="model">invoice.move.line.history</field>
    <field name="arch" type="xml">
      <search string="Search Sales Order Lines History">
        <field name="invoice_id" />
        <field name="partner_id" />
        <field name="product" />
        <group expand="0" string="Group By">
          <filter
            string="Invoice"
            name="invoice_id"
            domain="[]"
            context="{'group_by':'invoice_id'}"
          />
          <filter
            string="Partner"
            name="partner_id"
            domain="[]"
            context="{'group_by':'partner_id'}"
          />
          <filter
            string="Product"
            name="product"
            domain="[]"
            context="{'group_by':'product'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="invoice_move_lines_history_act" model="ir.actions.act_window">
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">invoice.move.line.history</field>
    <field name="view_mode">list,pivot,form</field>
    <field name="view_id" ref="view_invoice_line_history_menu_tree" />
    <field name="search_view_id" ref="invoice_line_history_filter" />
  </record>

  <menuitem
    id="menu_invoice_history"
    name="History Invoices"
    parent="account.menu_finance_reports"
    groups="account.group_account_invoice,account.group_account_user,account.group_account_manager"
    sequence="10"
  />

  <menuitem
    id="invoice_history_customer"
    name="Invoice Customer History"
    parent="menu_invoice_history"
    groups="account.group_account_invoice,account.group_account_user,account.group_account_manager"
    action="invoice_history_customer_act"
    sequence="4"
  />
  <menuitem
    id="invoice_history_supplier"
    name="Invoice Supplier History"
    parent="menu_invoice_history"
    groups="account.group_account_invoice,account.group_account_user,account.group_account_manager"
    action="invoice_history_supplier_act"
    sequence="5"
  />
  <menuitem
    id="invoice_move_line_history"
    name="Invoice move line history"
    parent="menu_invoice_history"
    groups="account.group_account_invoice,account.group_account_user,account.group_account_manager"
    action="invoice_move_lines_history_act"
    sequence="10"
  />
</odoo>
