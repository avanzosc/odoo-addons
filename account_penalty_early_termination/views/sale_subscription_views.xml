<odoo>
    <record id="sale_subscription_view_form" model="ir.ui.view">
        <field name="model">sale.subscription</field>
        <field
      name="inherit_id"
      ref="subscription_penalty.sale_subscription_view_form"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='subscription_penalty_ids']/tree/field[@name='applied_date']"
        position="after"
      >
                <field name="monthly_price" />
                <field name="penalty_months" />
                <field name="penalty_amount" />
            </xpath>
        </field>
    </record>
</odoo>
