<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_treasury_forecast_tree" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_tree" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <field name="project_id" optional="hide" />
        <field name="analytic_account_id" optional="hide" />
      </field>
    </field>
  </record>

  <record id="view_treasury_forecast_form" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_form" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <field name="project_id" />
        <field name="analytic_account_id" />
      </field>
    </field>
  </record>

  <record id="view_treasury_forecast_search" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_search" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <field name="project_id" />
        <field name="analytic_account_id" />
      </field>
      <filter name="filter_inactive" position="after">
        <filter
          string="Without a project or analytical account"
          name="filter_without-proj-analy"
          domain="[('project_id','=', False), ('analytic_account_id','=', False)]"
        />
        <filter
          string="Project and/or analytical account"
          name="filter_proj-or-analy"
          domain="[ ('analytic_account_id','=', False)]"
        />

        <filter
          string="Analytic Account"
          name="filter_analytic-account"
          domain="[('analytic_account_id','!=',False)]"
        />
      </filter>
      <filter name="group_journal" position="after">
        <filter
          string="Analytic Account"
          name="group_analytic_account"
          context="{'group_by':'analytic_account_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
