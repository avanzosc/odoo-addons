<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_treasury_forecast_tree" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_tree" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <field name="project_id" optional="hide" />
        <field name="analytic_account_id" optional="hide" />
      </field>
    </field>
  </record>

  <record id="view_treasury_forecast_form" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_form" />
    <field name="arch" type="xml">
      <group name="amounts" position="after">
        <group
          name="project-analytic"
          invisible="context.get('hide_project_analytic', False)"
        >
          <group>
            <separator string="Project" />
            <field name="project_id" />
          </group>
          <group>
            <separator string="Analytic" />
            <field name="analytic_account_id" />
          </group>
        </group>
      </group>
      <field name="financing_id" position="attributes">
        <attribute name="context">
              {'default_project_id': project_id,
               'default_analytic_account_id': analytic_account_id,
              }
          </attribute>
      </field>
    </field>
  </record>

  <record id="view_treasury_forecast_search" model="ir.ui.view">
    <field name="model">treasury.forecast</field>
    <field name="inherit_id" ref="treasury_forecast.view_treasury_forecast_search" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <field name="project_id" />
        <field name="analytic_account_id" />
      </field>
      <filter name="filter_journals" position="after">
        <filter
          string="Project"
          name="filter_project"
          domain="[('project_id','!=',False)]"
        />
        <filter
          string="Analytic Account"
          name="filter_analytic-account"
          domain="[('analytic_account_id','!=',False)]"
        />
      </filter>
      <filter name="group_journal" position="after">
        <filter
          string="Project"
          name="group_project"
          context="{'group_by':'project_id'}"
        />
        <filter
          string="Analytic Account"
          name="group_analytic_account"
          context="{'group_by':'analytic_account_id'}"
        />
      </filter>
    </field>
  </record>

  <record id="treasury_forecast.action_treasury_forecast" model="ir.actions.act_window">
    <field name="name">Treasury Forecast</field>
    <field name="res_model">treasury.forecast</field>
    <field name="view_mode">list,form,pivot</field>
    <field name="domain">[('project_id','=',False)]</field>
    <field name="context">{'hide_project_analytic': True}</field>
    <field
      name="view_ids"
      eval="[
        (ref('treasury_forecast.view_treasury_forecast_tree'), 'list'),
        (ref('treasury_forecast.view_treasury_forecast_form'), 'form'),
        (ref('treasury_forecast.view_treasury_forecast_pivot'), 'pivot')
    ]"
    />
  </record>
</odoo>
