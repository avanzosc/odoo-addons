<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_stock_product_template_tree" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_stock_product_template_tree" />
    <field name="arch" type="xml">
      <field name="virtual_available" position="after">
        <field
          name="show_incoming_qty_status_button"
          column_invisible="True"
          groups="stock.group_stock_user"
        />
        <field
          name="show_outgoing_qty_status_button"
          column_invisible="True"
          groups="stock.group_stock_user"
        />
        <field
          name="incoming_qty"
          invisible="not show_incoming_qty_status_button"
          optional="show"
          decoration-danger="incoming_qty &lt; 0"
          groups="stock.group_stock_user"
        />
        <field
          name="outgoing_qty"
          invisible="not show_outgoing_qty_status_button"
          optional="show"
          decoration-danger="outgoing_qty &lt; 0"
          groups="stock.group_stock_user"
        />
        <field name="main_seller_id" optional="show" />
        <field name="main_seller_price" optional="show" />
      </field>
      <field name="categ_id" position="after">
        <field name="parent_category_id" optional="hide" />
        <field name="root_category_id" optional="hide" />
      </field>
    </field>
  </record>

  <record id="product_template_search_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="main_seller_id" />
      </field>
      <filter name="categ_id" position="after">
        <filter
          string="Parent Category"
          name="parent_categ"
          context="{'group_by':'parent_category_id'}"
        />
        <filter
          string="Root Category"
          name="root_category"
          context="{'group_by':'root_category_id'}"
        />
        <filter
          string="Main Seller"
          name="main_seller"
          context="{'group_by':'main_seller_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
