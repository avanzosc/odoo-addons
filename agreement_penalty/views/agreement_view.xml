<odoo>
    <record id="agreement_form" model="ir.ui.view">
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button
          name="action_open_penalties"
          type="object"
          class="oe_stat_button"
          icon="fa-exclamation-triangle"
        >
                    <field name="penalty_count" widget="statinfo" string="Penalties" />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Penalties" name="penalties_tab">
                    <field name="agreement_penalty_ids">
                        <tree editable="bottom">
                            <field name="penalty_type_id" />
                            <field name="product_id" optional="show" />
                            <field name="penalty_price" optional="show" />
                            <field
                name="inactive_subscription_count"
                string="Inactive Subscriptions"
                optional="show"
              />
                            <field name="number" optional="show" />
                            <field
                name="penalty_percentage"
                widget="percentage"
                optional="show"
              />
                            <field name="notes" optional="hide" />
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="action_server_apply_penalties" model="ir.actions.server">
        <field name="name">Apply Penalties</field>
        <field name="model_id" ref="agreement.model_agreement" />
        <field name="binding_model_id" ref="agreement.model_agreement" />
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">records.apply_penalties()</field>
    </record>

    <record id="ir_cron_apply_penalties" model="ir.cron">
        <field name="name">Apply Penalties</field>
        <field name="model_id" ref="agreement.model_agreement" />
        <field name="state">code</field>
        <field name="code">records = env["agreement"].search([]);
for record in records:
    record.apply_penalties()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
    </record>

    <menuitem
    id="agreement_operation_menu"
    name="Agreements"
    parent="account_penalty.penalty_operation_menu"
    action="agreement.agreement_action"
    sequence="20"
  />
</odoo>
