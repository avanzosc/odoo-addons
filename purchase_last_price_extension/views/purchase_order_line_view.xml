<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="purchase_order_line_tree" model="ir.ui.view">
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="product_category" />
      </field>
      <field name="product_qty" position="after">
        <field name="standard_price" />
        <field name="standard_price_subtotal" sum="Total" />
        <field name="last_purchase_price" />
        <field name="last_purchase_price_subtotal" sum="Total" />
      </field>
    </field>
  </record>

  <record id="purchase_history_tree" model="ir.ui.view">
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_history_tree" />
    <field name="arch" type="xml">
      <field name="product_uom_qty" position="after">
        <field name="standard_price" />
        <field name="standard_price_subtotal" sum="Total" />
        <field name="last_purchase_price" />
        <field name="last_purchase_price_subtotal" sum="Total" />
      </field>
    </field>
  </record>
</odoo>
