<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_treasury_financing_tree" model="ir.ui.view">
    <field name="name">treasury.financing.tree</field>
    <field name="model">treasury.financing</field>
    <field name="arch" type="xml">
      <list>
        <field name="code" optional="show" />
        <field name="name" optional="show" />
        <field name="journal_id" optional="show" />
        <field name="partner_id" optional="show" />
        <field name="category_id" optional="show" />
        <field name="parent_category_id" optional="show" />
        <field name="category_type" optional="show" />
        <field name="base_product_id" optional="show" />
        <field name="interest_product_id" optional="show" />
        <field name="contract_date" optional="show" />
        <field name="start_date" optional="show" />
        <field name="end_date" optional="show" />
        <field name="installment_recurrence" optional="show" />
        <field name="interest_review_recurrence" optional="show" />
        <field name="installment_number" optional="show" />
        <field name="interest_conditions" optional="show" />
        <field name="total_amount" optional="show" />
        <field name="base_installment" optional="show" />
        <field name="current_interest_percent" optional="show" />
        <field name="interest_installment" optional="show" />
        <field name="installment_amount" optional="show" />
        <field name="last_forecast_date" optional="show" />
      </list>
    </field>
  </record>
  <record id="view_treasury_financing_form" model="ir.ui.view">
    <field name="name">treasury.financing.form</field>
    <field name="model">treasury.financing</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              type="object"
              name="action_view_forecast_lines"
              class="oe_stat_button"
              icon="fa-line-chart"
              invisible="forecast_line_count == 0"
            >
              <field
                name="forecast_line_count"
                widget="statinfo"
                string="Forecast Lines"
              />
            </button>
          </div>

          <group>
            <group>
              <field name="code" />
              <field name="name" />
              <field name="journal_id" />
              <field name="partner_id" />
              <field name="category_id" />
              <field name="parent_category_id" />
              <field name="category_type" readonly="1" />
              <field name="base_product_id" />
              <field name="interest_product_id" />
            </group>

            <group>
              <field name="contract_date" />
              <field name="start_date" />
              <field name="end_date" />
              <field name="installment_number" />
            </group>
          </group>

          <group>
            <group>
              <field name="installment_recurrence" />
              <field name="interest_review_recurrence" />
            </group>

            <group>
              <field name="total_amount" />
              <field name="last_forecast_date" />
            </group>
          </group>

          <group string="Installment Details">
            <group>
              <field name="base_installment" />
              <field name="interest_installment" />
            </group>

            <group>
              <field name="current_interest_percent" />
              <field name="installment_amount" readonly="1" />
            </group>
          </group>

          <group>
            <field name="interest_conditions" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_treasury_financing" model="ir.actions.act_window">
    <field name="name">Financing</field>
    <field name="res_model">treasury.financing</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem
    id="menu_treasury_financing"
    name="Financing"
    parent="menu_treasury_forecast_root"
    action="action_treasury_financing"
    sequence="3"
  />
  <record
    id="treasury_financing_generate_lines_server_action"
    model="ir.actions.server"
  >
    <field name="name">Crear previsiones</field>
    <field name="model_id" ref="model_treasury_financing" />
    <field name="binding_model_id" ref="model_treasury_financing" />
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
action = records.action_open_generate_lines_wizard()
    </field>
  </record>

  <record id="view_treasury_financing_search" model="ir.ui.view">
    <field name="name">treasury.financing.search</field>
    <field name="model">treasury.financing</field>
    <field name="arch" type="xml">
      <search string="Financing">
        <field name="code" />
        <field name="name" />
        <field name="partner_id" />
        <field name="journal_id" />
        <field name="category_id" />
        <field name="parent_category_id" />
        <field name="category_type" />
        <field name="base_product_id" />
        <field name="interest_product_id" />
        <field name="contract_date" />
        <field name="start_date" />
        <field name="end_date" />
        <field name="last_forecast_date" />
        <separator />

        <filter
          string="Partner"
          name="filter_customers"
          domain="[('partner_id','!=',False)]"
        />
        <filter
          string="Journal"
          name="filter_journal"
          domain="[('journal_id','!=',False)]"
        />

        <filter
          string="Category"
          name="filter_category"
          domain="[('category_id','!=',False)]"
        />
        <filter
          string="Parent category"
          name="filter_parent_category"
          domain="[('parent_category_id','!=',False)]"
        />
        <filter
          string="Category type"
          name="filter_category_type"
          domain="[('category_type','!=',False)]"
        />

        <filter
          string="Product"
          name="filter_product"
          domain="[('base_product_id','!=',False)]"
        />
        <filter
          string="Interest product"
          name="filter_interest_product"
          domain="[('interest_product_id','!=',False)]"
        />

        <filter
          string="Contract date"
          name="filter_contract_date"
          domain="[('contract_date','!=',False)]"
        />
        <filter
          string="Start date"
          name="filter_start_date"
          domain="[('start_date','!=',False)]"
        />
        <filter
          string="End date"
          name="filter_end_date"
          domain="[('end_date','!=',False)]"
        />

        <separator />

        <group expand="0" string="Group By">
          <filter
            string="Partner"
            name="group_partner"
            context="{'group_by':'partner_id'}"
          />
          <filter
            string="Journal"
            name="group_journal"
            context="{'group_by':'journal_id'}"
          />

          <filter
            string="Category"
            name="group_category"
            context="{'group_by':'category_id'}"
          />
          <filter
            string="Parent category"
            name="group_parent_category"
            context="{'group_by':'parent_category_id'}"
          />

          <filter
            string="Category type"
            name="group_category_type"
            context="{'group_by':'category_type'}"
          />

          <filter
            string="Product"
            name="group_base_product"
            context="{'group_by':'base_product_id'}"
          />
          <filter
            string="Interest product"
            name="group_interest_product"
            context="{'group_by':'interest_product_id'}"
          />

          <filter
            string="Contract date"
            name="group_contract_date"
            context="{'group_by':'contract_date'}"
          />
          <filter
            string="Start date"
            name="group_start_date"
            context="{'group_by':'start_date'}"
          />
          <filter
            string="End date"
            name="group_end_date"
            context="{'group_by':'end_date'}"
          />
        </group>
      </search>
    </field>
  </record>
</odoo>
