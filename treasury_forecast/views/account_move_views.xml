<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_tree_inherit_estimated_journal" model="ir.ui.view">
    <field name="name">account.move.tree.inherit.estimated.journal</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='journal_id']" position="after">
        <field name="estimated_journal_id" optional="show" />
      </xpath>
    </field>
  </record>
  <record id="account_view_move_form_inherit_estimated_journal" model="ir.ui.view">
    <field name="name">account.move.form.estimated.journal</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='journal_id']" position="after">
        <field name="estimated_journal_id" options="{'no_create': True}" />
      </xpath>
    </field>
  </record>
</odoo>
