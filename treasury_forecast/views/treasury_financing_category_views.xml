<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_treasury_financing_category_tree" model="ir.ui.view">
    <field name="name">treasury.financing.category.tree</field>
    <field name="model">treasury.financing.category</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="parent_id" />
        <field name="category_type" />
      </list>
    </field>
  </record>

  <record id="view_treasury_financing_category_form" model="ir.ui.view">
    <field name="name">treasury.financing.category.form</field>
    <field name="model">treasury.financing.category</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
            <field name="parent_id" />
            <field name="category_type" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_treasury_financing_category_search" model="ir.ui.view">
    <field name="name">treasury.financing.category.search</field>
    <field name="model">treasury.financing.category</field>
    <field name="arch" type="xml">
      <search string="Categorías de financiación">
        <field name="name" />
        <field name="parent_id" />
        <field name="category_type" />

        <separator />
        <filter
          string="Ingreso"
          name="filter_income"
          domain="[('category_type','=','income')]"
        />
        <filter
          string="Gasto"
          name="filter_expense"
          domain="[('category_type','=','expense')]"
        />

        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Categoría padre"
            name="group_parent"
            context="{'group_by':'parent_id'}"
          />
          <filter
            string="Tipo"
            name="group_type"
            context="{'group_by':'category_type'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_treasury_financing_category" model="ir.actions.act_window">
    <field name="name">Categorías de financiación</field>
    <field name="res_model">treasury.financing.category</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_treasury_financing_category_search" />
  </record>

  <menuitem
    id="menu_treasury_financing_category"
    name="Categorías de financiación"
    parent="menu_treasury_forecast_root"
    action="action_treasury_financing_category"
    sequence="4"
  />
</odoo>
