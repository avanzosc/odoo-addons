    <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>

  <record id="treasury_forecast_report_company_rule" model="ir.rule">
    <field name="name">Treasury Forecast Report multi-company</field>
    <field name="model_id" ref="model_treasury_forecast_report" />
    <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>
</odoo>
