<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="treasury_financing_company_rule" model="ir.rule">
    <field name="name">Treasury Financing multi-company</field>
    <field name="model_id" ref="model_treasury_financing" />
    <field
      name="domain_force"
    >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
  </record>

  <record id="treasury_forecast_company_rule" model="ir.rule">
    <field name="name">Treasury Forecast multi-company</field>
