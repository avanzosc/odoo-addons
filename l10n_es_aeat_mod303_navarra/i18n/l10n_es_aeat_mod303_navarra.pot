#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model,name:l10n_es_aeat_mod303_navarra.model_l10n_es_aeat_mod303_report
msgid "AEAT 303 Report"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_69
msgid ""
"Annual regularization of the fourth quarter. It corresponds to box 68 of the"
" 303 return."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid "Annual summary of transactions"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_63
msgid "Box 61 - box 62 + annual regularization (box 69)."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"Boxes 164/165 are only filled in the fourth quarter or in the cessation of "
"activity period."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_compensar
msgid ""
"Check this box if the negative result of the period is left pending offset "
"with the Navarra Regional Tax Agency instead of requesting a refund."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_264
msgid ""
"Check this box if you have carried out exempt transactions without the right"
" to deduction during the settlement period."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_164
msgid ""
"Check this box if you have carried out transactions with any person or "
"entity that, as a whole, have exceeded €3,005.06 during the calendar year."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_265
msgid ""
"Check this box if you have not carried out exempt transactions without the "
"right to deduction during the settlement period."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_165
msgid ""
"Check this box if you have not had any customer or supplier with whom you "
"have exceeded €3,005.06 during the calendar year."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_cifra_relativa
msgid ""
"Definitive relative figure percentage. In the first three quarters the "
"definitive percentage from the previous year is used. In the fourth quarter "
"the definitive percentage for the current year is reported."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid "Exempt transactions without right to deduction"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields.selection,name:l10n_es_aeat_mod303_navarra.selection__l10n_es_aeat_mod303_report__navarra_modo_pago__7
msgid "If payable. Direct debit of the declarant"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields.selection,name:l10n_es_aeat_mod303_navarra.selection__l10n_es_aeat_mod303_report__navarra_modo_pago__2
msgid ""
"If payable. Request to the Tax Agency to process payment with the bank "
"acting the presenter on behalf of the declarant electronically"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields.selection,name:l10n_es_aeat_mod303_navarra.selection__l10n_es_aeat_mod303_report__navarra_modo_pago__3
msgid ""
"If payable. Request to the Tax Agency to process payment with the bank by "
"provision of funds by the presenter of the return electronically"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields.selection,name:l10n_es_aeat_mod303_navarra.selection__l10n_es_aeat_mod303_report__navarra_modo_pago__1
msgid ""
"If payable. Request to the Tax Agency to process payment with the bank in "
"the name of the return electronically"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"In the first three quarters the Navarra relative figure must match the "
"definitive percentage from the previous year (%(pct)s %%)."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__is_tax_agency_navarra
msgid ""
"Indicates whether the company has the Navarra Regional Tax Agency configured"
" as its tax agency."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_61
msgid ""
"Intermediate result of the general regime: (VAT accrued - VAT deductible) "
"multiplied by the relative figure in box 55."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,field_description:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_compensar
msgid "Leave the negative result to be offset"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid "Navarra (F66/F69)"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,field_description:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__is_tax_agency_navarra
msgid "Navarra Company"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,field_description:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_modo_pago
msgid "Navarra payment method"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_62
msgid ""
"Negative balance pending offset from the previous return, only if it was "
"chosen to offset it with Navarra."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields.selection,name:l10n_es_aeat_mod303_navarra.selection__l10n_es_aeat_mod303_report__navarra_modo_pago__0
msgid "No request for payment processing"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid "Payment method"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid "Relative figure and result"
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model_terms:ir.ui.view,arch_db:l10n_es_aeat_mod303_navarra.view_l10n_es_aeat_mod303_report_form_navarra
msgid ""
"Specific boxes of the Navarra Regional Tax Agency. They do not modify the "
"official export of form 303."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"The Navarra payment method can only be different from 0 when the final "
"result (box 63) is positive."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid "The Navarra relative figure must be between 0 and 100."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#: model:ir.model.fields,help:l10n_es_aeat_mod303_navarra.field_l10n_es_aeat_mod303_report__navarra_casilla_50
msgid ""
"Total deductible VAT for the period. It corresponds to the sum of the "
"deductible amounts of form 303 (boxes 29, 31, 33, 35, 37, 39, 41, 42, 43 and"
" 44), equivalent to box 50 of the F66."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"You cannot check boxes 164 and 165 of the Navarra annual summary at the same"
" time."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"You cannot check boxes 264 and 265 of Navarra exempt transactions at the "
"same time."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"You must check box 164 (YES) or 165 (NO) of the Navarra annual summary."
msgstr ""

#. module: l10n_es_aeat_mod303_navarra
#. odoo-python
#: code:addons/l10n_es_aeat_mod303_navarra/models/mod303.py:0
msgid ""
"You must check box 264 (YES) or 265 (NO) of Navarra exempt transactions."
msgstr ""

