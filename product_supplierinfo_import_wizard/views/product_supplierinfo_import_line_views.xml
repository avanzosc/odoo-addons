<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_supplierinfo_import_line_view_search" model="ir.ui.view">
    <field name="model">product.supplierinfo.import.line</field>
    <field name="arch" type="xml">
      <search>
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <separator />
        <filter
          string="To Update"
          name="2update"
          domain="[('action', '=', 'update')]"
        />
        <filter
          string="To Create"
          name="2create"
          domain="[('action', '=', 'create')]"
        />
        <filter
          string="Do Nothing"
          name="do_nothing"
          domain="[('action', '=', 'nothing')]"
        />
        <group expand="0" string="Group By">
          <filter
            string="Product"
            name="product_group"
            domain="[]"
            context="{'group_by':'product_tmpl_id'}"
          />
          <filter
            string="Supplier"
            name="supplier_group"
            domain="[]"
            context="{'group_by':'supplier_id'}"
          />
          <separator />
          <filter string="Status" name="group_status" context="{'group_by': 'state'}" />
          <filter string="Action" name="group_action" context="{'group_by':'action'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="product_supplierinfo_import_line_view_form" model="ir.ui.view">
    <field name="model">product.supplierinfo.import.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="button_validate"
            string="Validate"
            type="object"
            invisible="state not in ('2validate', 'pass', 'error')"
          />
          <button
            name="button_process"
            string="Process"
            type="object"
            class="oe_read_only"
            invisible="state not in ('pass', 'error')"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="product_code" />
              <field name="product_name" />
              <field name="product_barcode" />
            </group>
            <group>
              <field
                name="product_tmpl_id"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <group>
            <group>
              <field name="supplier_name" />
            </group>
            <group>
              <field
                name="supplier_id"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <group>
            <group>
              <field name="currency_code" />
            </group>
            <group>
              <field
                name="currency_id"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <field name="log_info" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_supplierinfo_import_line_base_view_tree" model="ir.ui.view">
    <field name="model">product.supplierinfo.import.line</field>
    <field name="arch" type="xml">
      <list
        decoration-danger="state == 'error'"
        decoration-muted="state == 'done'"
        decoration-it="log_info"
        multi_edit="1"
        editable="top"
        duplicate="false"
      >
        <field
          name="import_id"
          column_invisible="context.get('default_import_id', True)"
        />
        <field
          name="action"
          decoration-muted="action == 'nothing'"
          decoration-success="action == 'install'"
          decoration-info="action == 'update'"
          readonly="state == 'done'"
        />
        <field name="sequence" />
        <field name="product_code" />
        <field name="product_name" />
        <field name="product_barcode" />
        <field
          name="product_tmpl_id"
          invisible="context.get('import_hide', True)"
          options="{'no_create': True}"
        />
        <field name="supplier_name" />
        <field
          name="supplier_id"
          invisible="context.get('import_hide', True)"
          options="{'no_create': True}"
        />
        <field name="supplier_product_name" />
        <field name="supplier_product_code" />
        <field name="min_qty" />
        <field name="price" string="Price" />
        <field name="currency_code" />
        <field
          name="currency_id"
          invisible="context.get('import_hide', True)"
          options="{'no_create': True}"
        />
        <field name="date_start" />
        <field name="date_end" />
        <field name="state" readonly="1" invisible="1" />
        <field
          name="log_info"
          readonly="1"
          invisible="context.get('import_hide', True)"
        />
        <button
          name="button_validate"
          type="object"
          title="Validate"
          icon="fa-search"
          invisible="state not in ('2validate', 'pass', 'error')"
        />
        <button
          name="button_process"
          type="object"
          title="Process"
          icon="fa-check"
          invisible="state not in ('pass')"
        />
      </list>
    </field>
  </record>

  <record id="product_supplierinfo_import_line_view_tree" model="ir.ui.view">
    <field name="model">product.supplierinfo.import.line</field>
    <field name="inherit_id" ref="product_supplierinfo_import_line_base_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <field name="import_id" position="attributes">
        <attribute name="column_invisible" />
        <attribute name="optional">hide</attribute>
      </field>
    </field>
  </record>

  <record id="product_supplierinfo_import_line_action" model="ir.actions.act_window">
    <field name="name">Import Product Variant Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">product.supplierinfo.import.line</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_supplierinfo_import_line_view_tree" />
  </record>

  <menuitem
    id="product_supplierinfo_import_line_menu"
    action="product_supplierinfo_import_line_action"
    parent="supplierinfo_import_menu"
    sequence="11"
  />

  <record id="action_validate_line" model="ir.actions.server">
    <field name="name">Validate</field>
    <field name="model_id" ref="model_product_supplierinfo_import_line" />
    <field name="binding_model_id" ref="model_product_supplierinfo_import_line" />
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">
            if records:
                records.button_validate()
        </field>
  </record>

  <record id="action_process_line" model="ir.actions.server">
    <field name="name">Process</field>
    <field name="model_id" ref="model_product_supplierinfo_import_line" />
    <field name="binding_model_id" ref="model_product_supplierinfo_import_line" />
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">
            for record in records:
                record.button_process()
        </field>
  </record>
</odoo>
