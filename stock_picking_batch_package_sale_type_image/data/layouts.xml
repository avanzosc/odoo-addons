<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
    id="external_layout_standard"
    inherit_id="sale_order_type_image.external_layout_standard"
    priority="100"
  >
        <t
      t-elif="o._name == 'sale.order' and o.type_id.sale_type_image"
      position="after"
    >
            <t
        t-elif="o._name == 'stock.picking.batch' and o.sale_order_type_id and o.sale_order_type_id.sale_type_image"
      >
                <img
          t-att-src="image_data_uri(o.sale_order_type_id.sale_type_image)"
          alt="Logo"
        />
            </t>
        </t>
    </template>
</odoo>
