<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="res_partner_purchase_group_tree_view" model="ir.ui.view">
    <field name="model">res.partner.purchase_group</field>
    <field name="arch" type="xml">
      <list editable="top">
        <field name="name" />
        <field name="billing_customer_id" />
        <field name="require_num_sales_authorization" />
      </list>
    </field>
  </record>

  <record id="res_partner_purchase_group_action" model="ir.actions.act_window">
    <field name="name">Cooperative</field>
    <field name="res_model">res.partner.purchase_group</field>
    <field name="view_mode">list</field>
  </record>

  <menuitem
    action="res_partner_purchase_group_action"
    id="menu_res_partner_purchase_group"
    name="Cooperatives"
    parent="contacts.res_partner_menu_config"
    sequence="3"
  />
</odoo>
