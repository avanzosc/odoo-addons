<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_partner_form" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <field name="category_id" position="after">
        <field name="ates" />
        <label for="distance" />
        <div class="o_row" name="distance">
          <field name="distance" />
          <span>Km</span>
        </div>
      </field>
      <xpath expr="//group/group" position="inside">
        <field name="is_supplier" invisible="1" />
        <field name="is_farmer" invisible="1" />
        <field name="farm" invisible="1" />
        <field name="main_scale" invisible="not farm" />
        <field name="chicken_supplier" invisible="not is_supplier" />
        <field
          name="chicken_supplier_id"
          domain="[('chicken_supplier', '=', True)]"
          invisible="not is_farmer"
        />
      </xpath>
    </field>
  </record>
</odoo>
