<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_partner_form_barcode_format" model="ir.ui.view">
    <field name="name">res.partner.form.barcode.format</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Barcode Format">
          <field
            name="barcode_format_ids"
            mode="list,form"
            readonly="0"
            context="{'default_partner_ids': [id]}"
          >
            <list>
              <field name="name" />
              <field name="type" />
              <field name="model_id" />
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
