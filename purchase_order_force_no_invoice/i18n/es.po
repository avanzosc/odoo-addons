#. module: purchase_order_force_no_invoice
#: model:ir.model.fields,field_description:purchase_order_force_no_invoice.field_purchase_order__force_no_invoice
msgid "Force Nothing to Bill"
msgstr "Forzar nada que facturar"

#. module: purchase_order_force_no_invoice
#: model:ir.module.module,summary:purchase_order_force_no_invoice.module_meta_information
msgid "Force a purchase order's billing status to \"Nothing to Bill\""
msgstr ""
"Fuerza el estado de facturación de un pedido de compra a «Nada que facturar»"

#. module: purchase_order_force_no_invoice
#: model:ir.model.fields,help:purchase_order_force_no_invoice.field_purchase_order__force_no_invoice
msgid ""
"If checked, the order's billing status is forced to 'Nothing to Bill' even if "
"there are lines or quantities still pending billing."
msgstr ""
"Si se marca, el estado de facturación del pedido se fuerza a «Nada que "
"facturar» aunque haya líneas o cantidades pendientes de facturar."

#. module: purchase_order_force_no_invoice
#: model:ir.model,name:purchase_order_force_no_invoice.model_purchase_order
msgid "Purchase Order"
msgstr "Pedido de compra"

#. module: purchase_order_force_no_invoice
#: model:ir.module.module,shortdesc:purchase_order_force_no_invoice.module_meta_information
msgid "Purchase Order Force No Invoice"
msgstr "Forzar nada que facturar"
