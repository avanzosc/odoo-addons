<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='order_line']/tree//field[@name='account_analytic_id']"
        position="after"
      >
                <field
          name="purchase_vehicle_id"
          optional="hide"
          groups="analytic.group_analytic_accounting,fleet.fleet_group_user"
        />
            </xpath>
        </field>
    </record>
</odoo>
