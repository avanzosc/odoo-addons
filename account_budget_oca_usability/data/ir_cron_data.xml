<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <record forcecreate="True" id="ir_cron_recompute_practical_amount" model="ir.cron">
    <field name="name">Budget Lines: Recompute practical amount</field>
    <field name="model_id" ref="model_crossovered_budget_lines" />
    <field name="state">code</field>
    <field name="code">model._cron_recompute_practical_amount()</field>
    <field eval="True" name="active" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field
      name="nextcall"
      eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
  </record>
</odoo>
