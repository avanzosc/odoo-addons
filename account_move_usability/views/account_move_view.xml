<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_form_blocked_fix" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account_payment_order.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//button[@name='create_account_payment_line']" position="attributes">
        <attribute name="invisible" add="payment_state == 'blocked'" separator=" or " />
      </xpath>
    </field>
  </record>
  <record id="view_move_form_product_domain_fix" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_line_ids']" position="attributes">
        <attribute name="context">
                    {
                        'default_move_type': move_type or context.get('default_move_type'),
                        'journal_id': journal_id,
                        'default_partner_id': commercial_partner_id,
                        'default_currency_id': currency_id or company_currency_id,
                        'default_display_type': 'product',
                        'quick_encoding_vals': quick_encoding_vals,
                    }
        </attribute>
      </xpath>
    </field>
  </record>
</odoo>
