<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_supplierinfo_tree_view" model="ir.ui.view">
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view" />
        <field name="arch" type="xml">
            <field name="product_code" position="after">
                <field name="product_brand_id" optional="show" />
                <field name="brand_code" optional="show" />
            </field>
            <field name="partner_id" position="after">
                <field name="product_tmpl_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field
          name="brand_product_id"
          options="{'no_create': True}"
          domain="[('product_tmpl_id','=', product_tmpl_id),
                   ('state', '=', 'homologation')]"
        />
            </field>
        </field>
    </record>

    <record id="product_supplierinfo_form_view" model="ir.ui.view">
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delay']/.." position="after">

                <field
          name="brand_product_id"
          options="{'no_create': True}"
          domain="[('product_tmpl_id','=', product_tmpl_id),
                   ('state', '=', 'homologation')]"
        />
                <field name="product_brand_id" />
                <field name="brand_code" />
            </xpath>
        </field>
    </record>

    <record id="product_supplierinfo_search_view" model="ir.ui.view">
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_search_view" />
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="product_brand_id" />
                <field name="brand_code" />
            </field>
            <filter name="groupby_vendor" position="after">
                <filter
          string="Product Brand"
          name="groupby_brand"
          domain="[]"
          context="{'group_by': 'product_brand_id'}"
        />
                <filter
          string="Brand Code"
          name="groupby_brand_code"
          domain="[]"
          context="{'group_by': 'brand_code'}"
        />
            </filter>
        </field>
    </record>

    <menuitem
    name="Vendor Pricelist"
    id="menu_stock_product_supplierinfo"
    action="product.product_supplierinfo_type_action"
    parent="product_brand_supplierinfo.stock_brand_menu"
    sequence="40"
  />
</odoo>
