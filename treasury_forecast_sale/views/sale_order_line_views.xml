<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_sale_order_line_tree_product_category" model="ir.ui.view">
    <field name="name">sale.order.line.tree.product.category</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_order_line_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="before">
        <field name="product_category_id" />
      </xpath>
    </field>
  </record>

  <record id="view_sale_order_line_form_product_category" model="ir.ui.view">
    <field name="name">sale.order.line.form.product.category</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="before">
        <field name="product_category_id" />
      </xpath>
    </field>
  </record>
</odoo>
