<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_treasury_forecast_sale_order_wizard_form" model="ir.ui.view">
    <field name="name">treasury.forecast.sale.order.wizard.form</field>
    <field name="model">treasury.forecast.sale.order.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Sales Quotation">
        <group>
          <field name="forecast_line_ids" invisible="1" />
          <field name="partner_id" />
        </group>
        <footer>
          <button
            name="button_create_sale_order"
            type="object"
            string="Create Sales Quotation"
            class="btn-primary"
          />
          <button string="Cancel" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_treasury_forecast_sale_order_wizard" model="ir.actions.act_window">
    <field name="name">Create Sales Quotation</field>
    <field name="res_model">treasury.forecast.sale.order.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_treasury_forecast_sale_order_wizard_form" />
    <field name="target">new</field>
    <field name="binding_model_id" ref="treasury_forecast.model_treasury_forecast" />
    <field name="binding_view_types">list,form</field>
  </record>
</odoo>
