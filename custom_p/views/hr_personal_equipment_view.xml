<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_personal_equipment_tree_view" model="ir.ui.view">
        <field name="model">hr.personal.equipment</field>
        <field
      name="inherit_id"
      ref="hr_personal_equipment_request.hr_personal_equipment_tree_view"
    />
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="job_id" />
            </field>
        </field>
    </record>

    <record id="hr_personal_equipment_search_view" model="ir.ui.view">
        <field name="model">hr.personal.equipment</field>
        <field
      name="inherit_id"
      ref="hr_personal_equipment_request.hr_personal_equipment_search_view"
    />
        <field name="arch" type="xml">
            <filter name="filter_employee_id" position="after">
                <filter name="job" string="Job" context="{'group_by' : 'job_id'}" />
            </filter>
        </field>
    </record>
</odoo>
