<odoo>
    <record
    id="view_move_line_detailed_operation_tree_inherit_expiration"
    model="ir.ui.view"
  >
        <field name="name">stock.move.line.detailed.operation.tree.expiration</field>
        <field name="model">stock.move.line</field>
        <field
      name="inherit_id"
      ref="stock.view_stock_move_line_detailed_operation_tree"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field
          name="manual_expiration_date"
          string="Expiration Date Manual"
          optional="show"
        />
            </xpath>
        </field>
    </record>
</odoo>
