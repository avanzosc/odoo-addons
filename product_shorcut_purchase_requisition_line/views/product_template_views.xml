        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
          class="oe_stat_button"
          name="open_purchase_requisition_line"
          icon="fa-list-ul"
          type="object"
        >
                    <field
            string="Amount agreement"
            name="purchase_requisition_line_qty"
            widget="statinfo"
          />
                </button>
            </div>
        </field>
     </record>
</odoo>
