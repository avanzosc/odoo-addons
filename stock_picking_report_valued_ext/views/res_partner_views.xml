<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_partner_valued_picking_child_form" model="ir.ui.view">
    <field name="name">res.partner.valued.picking.child.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='child_ids']/form//field[@name='comment']"
        position="after"
      >
        <field name="valued_picking" invisible="type not in ('delivery', 'other')" />
      </xpath>
    </field>
  </record>
</odoo>
