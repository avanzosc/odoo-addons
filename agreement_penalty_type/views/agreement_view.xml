<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="agreement_form" model="ir.ui.view">
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[last()]" position="after">
                <page string="Penalties" name="penalties">
                    <field name="agreement_penalty_ids">
                        <tree editable="bottom">
                            <field name="penalty_type_id"/>
                            
                            <field name="product_id" optional="show"/>
                            <field name="penalty_price" optional="show"/>
                            <field name="percentage" optional="show"/>
                            
                            <field name="quantity"/>
                            <field name="term"/>
                            <field name="notes"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
