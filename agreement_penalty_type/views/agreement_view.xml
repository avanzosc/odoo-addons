<odoo>
    <record id="agreement_form" model="ir.ui.view">
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='main']/group[@name='right']" position="inside">
                <field name="active_subscription_total" string="Active Subscriptions"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Penalties" name="penalties_tab">
                    <field name="agreement_penalty_ids">
                        <tree editable="bottom">
                            <field name="penalty_type_id"/>
                            <field name="number" string="Duration" optional="show"/>
                            <field name="term" string="Term" optional="show"/>
                            <field name="penalty_percentage" string="Penalty %" widget="percentage" optional="show"/>
                            <field name="notes" string="Notes" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
