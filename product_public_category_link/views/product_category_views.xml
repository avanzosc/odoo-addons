<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_product_category_form_inherit" model="ir.ui.view">
    <field name="name">product.category.form.inherit.public.category</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_form_view" />
    <field name="arch" type="xml">
      <field name="parent_id" position="after">
        <field
          name="public_category_ids"
          widget="many2many_tags"
          string="Public Categories"
          placeholder="Select public categories..."
          class="oe_inline"
        />
      </field>
    </field>
  </record>

  <record id="view_product_category_tree_inherit" model="ir.ui.view">
    <field name="name">product.category.tree.inherit.public.category</field>
    <field name="model">product.category</field>
    <field name="inherit_id" ref="product.product_category_list_view" />
    <field name="arch" type="xml">
      <field name="display_name" position="after">
        <field
          name="public_category_ids"
          widget="many2many_tags"
          string="Public Categories"
        />
      </field>
    </field>
  </record>
</odoo>
