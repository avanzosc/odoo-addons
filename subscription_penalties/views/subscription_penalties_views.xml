<odoo>
    <record id="view_subscription_penalties_tree" model="ir.ui.view">
        <field name="model">subscription.penalties</field>
        <field name="arch" type="xml">
            <tree>
                <field name="subscription_id" widget="many2one" />
                <field name="penalty_type_id" widget="many2one" />
                <field name="applied_date" />
            </tree>
        </field>
    </record>

    <record id="view_subscription_penalties_form" model="ir.ui.view">
        <field name="model">subscription.penalties</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="subscription_id" />
                        <field name="penalty_type_id" />
                        <field name="applied_date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_penalties_search" model="ir.ui.view">
        <field name="model">subscription.penalties</field>
        <field eval="10" name="priority" />
        <field name="arch" type="xml">
            <search string="Subscription Penalties">
                <field name="subscription_id" />
                <field name="penalty_type_id" />
                <field name="applied_date" />
                <group expand='0' string='Group by...'>
                    <filter
            string='Subscription'
            name="subscription"
            context="{'group_by': 'subscription_id'}"
          />
                    <filter
            string='Penalty Type'
            name="penaltytype"
            context="{'group_by': 'penalty_type_id'}"
          />
                    <filter
            string='Applied Date'
            name="applieddate"
            context="{'group_by': 'applied_date'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="action_subscription_penalties" model="ir.actions.act_window">
        <field name="name">Subscription Penalties</field>
        <field name="res_model">subscription.penalties</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
    id="menu_subscription_penalties"
    name="Subscription Penalties"
    parent="sale_subscription.menu_sale_subscription"
    action="action_subscription_penalties"
    sequence="50"
  />

</odoo>
