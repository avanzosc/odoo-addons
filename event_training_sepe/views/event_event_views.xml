<odoo>
  <record id="view_event_event_form_training_sepe" model="ir.ui.view">
    <field name="name">event.event.form.training.sepe</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="event.view_event_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Formación SEPE" name="training_sepe">
          <group>
            <field name="training_action_id" />
            <field name="training_action_code" />
            <field name="training_funding_id" />
            <field name="training_specialty_code" />
          </group>
          <group>
            <field name="training_funder_id" />
            <field name="training_payer_id" />
            <field name="training_modality" />
            <field name="training_hours" />
          </group>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
