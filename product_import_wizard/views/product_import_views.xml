<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_import_view_tree" model="ir.ui.view">
    <field name="model">product.import</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'done'" decoration-bf="state == 'pass'">
        <field name="name" />
        <field name="file_date" />
        <field name="state" />
        <field name="company_id" />
      </list>
    </field>
  </record>

  <record id="product_import_view_form" model="ir.ui.view">
    <field name="model">product.import</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_import_file"
            string="Import"
            type="object"
            invisible="state == 'done'"
          />
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ('2validate', 'pass', 'error')"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state not in ('pass', 'error')"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              invisible="not import_line_ids"
              class="oe_stat_button"
              icon="fa-bars"
            />
            <button
              type="object"
              name="button_open_product"
              invisible="product_count == 0"
              class="oe_stat_button"
              icon="fa-folder-open"
            >
              <field name="product_count" widget="statinfo" />
            </button>
          </div>
          <group>
            <group>
              <field name="filename" />
              <field
                name="data"
                readonly="state == 'done'"
                widget="binary"
                filename="filename"
              />
              <field name="file_date" />
              <field name="company_id" readonly="state == 'done'" />
            </group>
            <group>
              <field name="product_type" readonly="state == 'done'" />
              <field
                name="uom_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_create_edit': True}"
              />
              <field name="product_found_reference" readonly="state == 'done'" />
            </group>
          </group>
          <notebook>
            <page string="Imported Lines">
              <field name="import_line_ids" />
            </page>
            <page string="Error Log" invisible="not log_info">
              <field name="log_info" />
            </page>
            <page string="Help" invisible="state == 'done'">
              <group>
                <div name="help" style="margin-top: 4px;">
                  <h3>Help with Excel column names</h3>
                  <p>You must use this column names in order to fill the table:</p>
                  <ul>
                    <li><code>Name</code>: this will fill <b>Name.</b></li>
                    <li><code>Sales</code>: this will fill <b
                    >Sales. </b>The field must be <code>True</code> or <code
                    >False</code>.</li>
                    <li><code>Purchase</code>: this will fill <b
                    >Purchase. </b>The field must be <code>True</code> or <code
                    >False</code>.</li>
                    <li><code>Internal Reference</code>: this will fill <b
                    >Internal Reference.</b></li>
                    <li><code>Product Type</code>: this will fill <b
                    >Product Type.</b>The field must be:
                                            <ul>
                      <li><code>consu</code> for <b>Goods</b></li>
                      <li><code>service</code> for <b>Service</b></li>
                    </ul></li>
                    <li><code>Barcode</code>: this will fill <b>Barcode.</b></li>
                    <li><code>Sales Price</code>: this will fill <b
                    >Sales Price.</b></li>
                    <li><code>Sales Taxes</code>: this will fill <b
                    >Sales Taxes.</b></li>
                    <li><code>Cost</code>: this will fill <b>Cost.</b></li>
                    <li><code>Product Category</code>: this will fill <b
                    >Product Category.</b></li>
                    <li><code>Unit of Measure</code>: this will fill <b
                    >Unit of Measure.</b></li>
                    <li><code>Purchase Unit</code>: this will fill <b
                    >Purchase Unit.</b></li>
                    <li><code>Invoicing Policy</code>: this will fill <b
                    >Invoicing Policy.</b> The field must be:
                                            <ul>
                      <li><code>order</code> for <b>Ordered quantities</b></li>
                      <li><code>delivery</code> for <b>Delivered quantities</b></li>
                    </ul>
                                            </li>
                    <li><code>Control Policy</code>: this will fill <b
                    >Control Policy. </b>The field must be:
                                            <ul>
                      <li><code>purchase</code> for <b>On
                                                ordered quantities</b></li>
                      <li><code>receive</code> for <b>On received
                                                quantities</b></li>
                    </ul></li>
                    <li><code>Purchase Description</code>: this will fill <b
                    >Purchase Description. </b></li>
                    <li><code>Income Account</code>: this will fill <b
                    >Income Account. </b></li>
                    <li><code>Expense Account</code>: this will fill <b
                    >Expense Account. </b></li>
                  </ul>
                </div>
              </group>
            </page>
          </notebook>
        </sheet>
        <!--<div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div> -->
      </form>
    </field>
  </record>

  <record id="product_import_view_search" model="ir.ui.view">
    <field name="model">product.import</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <group expand="0" string="Group By">
          <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="product_import_action" model="ir.actions.act_window">
    <field name="name">Import Products</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">product.import</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="product_import_view_tree" />
  </record>

  <menuitem
    id="product_import_menu"
    action="product_import_action"
    parent="base_import_wizard.base_import_menu"
    sequence="10"
  />

  <menuitem
    id="product_import_inventory_menu"
    action="product_import_action"
    parent="stock.menu_product_in_config_stock"
    sequence="100"
  />
</odoo>
