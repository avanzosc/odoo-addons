<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_import_line_view_form" model="ir.ui.view">
    <field name="model">product.import.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="button_validate"
            string="Validate"
            type="object"
            class="oe_read_only"
            modifiers="2validate,error"
          />
          <button
            name="button_process"
            string="Process"
            type="object"
            class="oe_read_only"
            modifiers="pass"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="product_name" readonly="state == 'done'" />
              <field name="product_default_code" readonly="state == 'done'" />
              <field name="product_type" readonly="state == 'done'" />
              <field name="product_uom" readonly="state == 'done'" />
              <field name="category_name" readonly="state == 'done'" />
            </group>
            <group>
              <field
                name="product_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
              <field
                name="product_uom_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
              <field
                name="category_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <field name="log_info" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_import_line_view_tree" model="ir.ui.view">
    <field name="model">product.import.line</field>
    <field name="arch" type="xml">
      <list
        decoration-danger="state == 'error'"
        decoration-muted="state == 'done'"
        decoration-it="log_info"
        editable="top"
      >
        <field
          name="action"
          decoration-muted="action == 'nothing'"
          decoration-success="action == 'create'"
          decoration-info="action == 'update'"
          readonly="state == 'done'"
        />
        <field name="product_name" readonly="state == 'done'" />
        <field name="product_default_code" readonly="state == 'done'" />
        <field
          name="product_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True}"
        />
        <field name="sale_ok" readonly="state == 'done'" optional="hide" />
        <field name="purchase_ok" readonly="state == 'done'" optional="hide" />
        <field name="barcode" readonly="state == 'done'" optional="show" />
        <field name="list_price" readonly="state == 'done'" optional="show" />
        <field name="customer_tax" readonly="state == 'done'" optional="show" />
        <field
          name="customer_tax_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="standard_price" readonly="state == 'done'" optional="show" />
        <field name="product_uom" readonly="state == 'done'" />
        <field
          name="product_uom_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="purchase_uom_name" readonly="state == 'done'" optional="show" />
        <field
          name="purchase_uom_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="invoice_policy" readonly="state == 'done'" optional="show" />
        <field name="category_name" readonly="state == 'done'" />
        <field
          name="category_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="product_type" readonly="state == 'done'" optional="show" />
        <field name="purchase_method" readonly="state == 'done'" optional="show" />
        <field name="description_purchase" readonly="state == 'done'" optional="show" />
        <field
          name="property_account_income"
          readonly="state == 'done'"
          optional="show"
        />
        <field
          name="property_account_income_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field
          name="property_account_expense"
          readonly="state == 'done'"
          optional="show"
        />
        <field
          name="property_account_expense_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="state" optional="hide" />
        <field name="log_info" />
      </list>
    </field>
  </record>

  <record id="product_import_line_view_search" model="ir.ui.view">
    <field name="model">product.import.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="product_id" />
        <field name="barcode" />
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <separator />
        <filter
          string="To Update"
          name="2update"
          domain="[('action', '=', 'update')]"
        />
        <filter
          string="To Create"
          name="2create"
          domain="[('action', '=', 'create')]"
        />
        <filter
          string="Do Nothing"
          name="do_nothing"
          domain="[('action', '=', 'nothing')]"
        />
        <group expand="0" string="Group By">
          <filter
            string="Product Type"
            name="type_group"
            domain="[]"
            context="{'group_by':'product_type'}"
          />
          <filter
            string="Category"
            name="category_group"
            domain="[]"
            context="{'group_by':'category_id'}"
          />
          <filter
            string="Barcode"
            name="barcode_group"
            domain="[]"
            context="{'group_by':'barcode'}"
          />
          <separator />
          <filter name="group_status" string="Status" context="{'group_by': 'state'}" />
          <filter string="Action" name="group_action" context="{'group_by':'action'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="product_import_line_action" model="ir.actions.act_window">
    <field name="name">Import Product Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">product.import.line</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="product_import_line_view_tree" />
  </record>
</odoo>
