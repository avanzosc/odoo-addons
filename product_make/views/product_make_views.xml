<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_make_view_tree" model="ir.ui.view">
    <field name="model">product.make</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="print_make_on_out_picking" optional="show" />
        <field name="market_to_print_ids" widget="many2many_tags" optional="show" />
        <field name="use_logo" optional="show" />
        <field name="three_address_in_sale_report" optional="show" />
      </list>
    </field>
  </record>

  <record id="product_make_view_form" model="ir.ui.view">
    <field name="model">product.make</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" />
            </h1>
            <group name="body">
              <group name="group-1">
                <field name="use_logo" invisible="not logo" />
                <field name="print_make_on_out_picking" />
              </group>
              <group name='group-2'>
                <field name="three_address_in_sale_report" />
              </group>
            </group>
            <group name="body2">
              <group name="group-2">
                <separator string="Logo" />
                <br />
                <field name="logo" widget='image' class="oe_avatar" nolabel="1" />
                <field name="market_to_print_ids" widget="many2many_tags" />
              </group>
              <group name='group-2'>
                <separator string="Common logo" />
                <br />
                <field
                  name="common_logo"
                  widget='image'
                  class="oe_avatar"
                  nolabel="1"
                />
              </group>
            </group>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_make_form_action" model="ir.actions.act_window">
    <field name="name">Makes</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">product.make</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
            Add a new make for products.
          </p>
    </field>
  </record>

  <menuitem
    id="menu_product_make_form_action"
    action="product_make_form_action"
    parent="sale.prod_config_main"
    sequence="1"
  />
</odoo>
