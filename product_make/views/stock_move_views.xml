<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_stock_move_form" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_form" />
    <field name="arch" type="xml">
      <field name="location_dest_id" position="after">
        <field name="make_id" />
      </field>
      <field name="company_id" position="before">
        <field name="market_id" string="Sale channel" />
        <field name="market_sector_id" string="Market niche" />
      </field>
    </field>
  </record>

  <record id="view_move_tree" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_tree" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="make_id" optional="show" />
      </field>
      <field name="company_id" position="before">
        <field name="market_id" string="Sale channel" optional="show" />
        <field name="market_sector_id" string="Market niche" optional="show" />
      </field>
    </field>
  </record>

  <record id="view_move_search" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_search" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="make_id" />
        <field name="market_id" string="Sale channel" />
        <field name="market_sector_id" string="Market niche" />
      </field>
      <filter name="status" position="after">
        <filter
          string="Make"
          name="make"
          domain="[]"
          context="{'group_by':'make_id'}"
        />
      </filter>
      <filter name="groupby_dest_location_id" position="before">
        <filter
          string="Sale channel"
          name="market-id"
          domain="[]"
          context="{'group_by':'market_id'}"
        />
        <filter
          string="Market niche"
          name="market-sector-id"
          domain="[]"
          context="{'group_by':'market_sector_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
