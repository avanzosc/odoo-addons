<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          class="oe_stat_button"
          icon="fa-sitemap"
          type="object"
          name="action_view_distribution"
          invisible="not burden_to_incubator"
        >
          <field string="Distributions" name="distribution_count" widget="statinfo" />
        </button>
      </div>
      <xpath expr="//sheet/group/group/div" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
      </xpath>
      <field name="partner_id" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
      </field>
      <field name="batch_id" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
      </field>
      <field name="carrier_id" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
        <attribute name="readonly">state in ('done', 'cancel') and is_locked</attribute>
      </field>
      <div name="shipping_cost" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
        <attribute name="readonly">state in ('done', 'cancel') and is_locked</attribute>
      </div>
      <field name="transporter_id" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
      </field>
      <label for="shipping_cost" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
        <attribute name="readonly">state in ('done', 'cancel') and is_locked</attribute>
      </label>
      <field name="license_plate" position="attributes">
        <attribute
          name="invisible"
        >burden_to_incubator or egg_production or incubator_hatcher</attribute>
        <attribute name="readonly">state in ('done', 'cancel') and is_locked</attribute>
      </field>
      <field name="owner_id" position="attributes">
        <attribute name="invisible">egg_production or incubator_hatcher</attribute>
      </field>
      <field name="picking_type_id" position="attributes">
        <attribute name="invisible">False</attribute>
      </field>
      <xpath expr="//field[@name='picking_properties']" position="after">
        <field name="is_incubator" invisible="True" />
        <field name="is_integration" invisible="True" />
        <field name="is_reproductor" invisible="True" />
        <field name="is_feed_flour" invisible="True" />
        <field name="is_medicine" invisible="True" />
        <field name="egg_production" invisible="True" />
        <field name="burden_to_incubator" invisible="True" />
        <field name="incubator_hatcher" invisible="True" />
      </xpath>
      <field name="custom_date_done" position="replace">
        <field
          name="custom_date_done"
          readonly="state in ('done', 'cancel') and is_locked"
        />
        <field name="date_done_week" />
        <field name="birth_estimate_date" invisible="not burden_to_incubator" />
        <field name="date_birth_week" invisible="not burden_to_incubator" />
      </field>
      <page name="detailed_operations_shown" position="inside">
        <group>
          <group>
            <field name="birth_estimate_qty" invisible="not burden_to_incubator" />
          </group>
          <group>
            <field name="pending_qty" invisible="not burden_to_incubator" />
          </group>
        </group>
        <field
          name="distribution_ids"
          context="{'default_picking_id': id}"
          invisible="not burden_to_incubator"
        >
          <list editable="top">
            <field
              name="picking_id"
              domain="[('id', '=', parent.id)]"
              invisible="True"
            />
            <field name="birth_estimate_date" />
            <field name="batch_id" />
            <field name="product_id" domain="[('one_day_chicken', '=', True)]" />
            <field name="estimate_birth" />
            <field name="pending_qty" />
            <field name="distribute_qty" sum="Total Distribute Quantity" />
            <field name="warehouse_id" />
          </list>
        </field>
      </page>
      <page name="detailed_operations_shown" position="attributes">
        <attribute name="invisible">False</attribute>
      </page>
      <field name="move_line_ids_without_package" position="attributes">
        <attribute name="invisible">False</attribute>
      </field>
    </field>
  </record>

  <record id="action_picking_incub_repr_view" model="ir.actions.act_window">
    <field name="name">Picking</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field
      name="domain"
    >['|', ('is_incubator', '=', True), ('is_reproductor', '=', True)]</field>
  </record>

  <record id="action_picking_integr_view" model="ir.actions.act_window">
    <field name="name">Picking</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_integration', '=', True)]</field>
  </record>

  <record id="action_picking_medic_view" model="ir.actions.act_window">
    <field name="name">Picking</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_medicine', '=', True)]</field>
  </record>

  <record id="action_picking_flour_view" model="ir.actions.act_window">
    <field name="name">Picking</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">stock.picking</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_feed_flour', '=', True)]</field>
  </record>

  <menuitem
    action="action_picking_incub_repr_view"
    name="Pickings"
    id="menu_picking_incubator"
    parent="custom_breeding_apps.incubator_menu"
    sequence="7"
  />

  <menuitem
    action="action_picking_integr_view"
    name="Pickings"
    id="menu_picking_integration"
    parent="custom_breeding_apps.integration_menu"
    sequence="7"
  />

  <menuitem
    action="action_picking_medic_view"
    name="Pickings"
    id="menu_picking_medicine"
    parent="custom_breeding_apps.medicine_menu"
    sequence="7"
  />

  <menuitem
    action="action_picking_flour_view"
    name="Pickings"
    id="menu_picking_flour"
    parent="custom_breeding_apps.flour_menu"
    sequence="7"
  />
</odoo>
