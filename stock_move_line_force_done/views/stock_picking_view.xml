<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.ui.view" id="view_picking_form">
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath expr="//form/header/button[@name='action_assign']" position="after">
        <button
          name="button_force_done_detailed_operations"
          invisible="state not in ['waiting', 'confirmed', 'assigned'] or not show_operations"
          string="Force done detailed operations"
          type="object"
          groups="stock.group_stock_user"
          class="o_btn_validate"
        />
      </xpath>
    </field>
  </record>
</odoo>
