<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="purchase_order_line_tree" model="ir.ui.view">
    <field name="active" eval="False" />
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase_order_line_menu.purchase_order_line_tree" />
    <field name="arch" type="xml">
      <field name="qty_received" position="before">
        <field name="qty_to_receive" optional="hide" />
      </field>
      <field name="qty_invoiced" position="before">
        <field name="qty_to_invoice" optional="hide" />
      </field>
    </field>
  </record>
</odoo>
