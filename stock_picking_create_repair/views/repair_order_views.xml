<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_repair_order_tree" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_tree" />
    <field name="arch" type="xml">
      <field name="user_id" position="before">
        <field name="purchase_order_id" optional="show" />
        <field
          name="created_from_picking_id"
          string="Incoming Picking"
          optional="show"
        />
        <field name="created_from_move_line_id" optional="show" />
        <field name="sale_order_id" optional="show" />
        <field name="invoice_ids" widget="many2many_tags" optional="show" />
      </field>
      <field name="company_id" position="before">
        <field
          name="price_in_sale_budget"
          optional="show"
          sum="Total price in budget"
        />
        <field name="amount_untaxed" optional="show" sum="Total amount untaxec" />
      </field>
      <field name="product_id" position="after">
        <field name="lot_id" optional="show" />
      </field>
      <field name="partner_id" position="after">
        <field name="partner_invoice_id" readonly="1" optional="show" />
        <field name="address_id" readonly="1" optional="hide" />
      </field>
    </field>
  </record>

  <record id="view_repair_order_form" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="created_from_picking_id" />
        <field name="purchase_order_id" />
        <field name="price_in_sale_budget" />
        <field name="is_repair" invisible="1" />
      </field>
      <field name="tag_ids" position="after">
        <field name="created_from_move_line_id" />
        <field name="sale_order_id" />
        <field name="invoice_ids" widget="many2many_tags" readonly="1" />
      </field>
      <xpath
        expr="//page[@name='page_miscellaneous']//field[@name='picking_type_id']"
        position="after"
      >
        <field name="from_repair_picking_out_id" readonly="1" />
      </xpath>
      <field name="partner_id" position="after">
        <field
          name="partner_invoice_id"
          widget="res_partner_many2one"
          readonly="sale_order_id"
        />
        <field
          name="address_id"
          widget="res_partner_many2one"
          readonly="sale_order_id"
        />
      </field>
    </field>
  </record>

  <record id="view_repair_order_form_filter" model="ir.ui.view">
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form_filter" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field
          name="partner_invoice_id"
          filter_domain="[('partner_invoice_id', 'child_of', self)]"
        />
        <field name="address_id" filter_domain="[('address_id', 'child_of', self)]" />
      </field>
      <field name="partner_id" position="before">
        <field name="purchase_order_id" />
        <field name="created_from_picking_id" />
        <field name="sale_order_id" />
        <field name="invoice_ids" />
      </field>
      <filter name="returned" position="after">
        <separator />
        <filter
          string="Created from incoming picking"
          name="from-incoming-picking"
          domain="[('created_from_picking_id', '!=', False)]"
        />
        <filter
          string="No created from incoming picking"
          name="no-from-incoming-picking"
          domain="[('created_from_picking_id', '=', False)]"
        />
        <separator />
      </filter>
      <filter name="company" position="after">
        <filter
          string="Purchase order"
          name="group-purchase-order"
          domain="[]"
          context="{'group_by': 'purchase_order_id'}"
        />
        <filter
          string="Created from incoming picking"
          name="group-incoming_picking"
          domain="[]"
          context="{'group_by': 'created_from_picking_id'}"
        />
        <filter
          string="Sale order"
          name="group-sale-order"
          domain="[]"
          context="{'group_by': 'sale_order_id'}"
        />
        <filter
          string="Invoice"
          name="group-invoice"
          domain="[]"
          context="{'group_by': 'invoice_ids'}"
        />
      </filter>
      <filter name="partner" position="after">
        <filter
          string="Invoicing Address"
          name="partner-invoice"
          domain="[]"
          context="{'group_by': 'partner_invoice_id'}"
        />
        <filter
          string="Delivery Address"
          name="address"
          domain="[]"
          context="{'group_by': 'address_id'}"
        />
      </filter>
    </field>
  </record>

  <record id="action_repair_start_multiple" model="ir.actions.server">
    <field name="name">Start repairs</field>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="model_id" ref="model_repair_order" />
    <field name="binding_model_id" ref="model_repair_order" />
    <field name="code">
if records:
    action = records.control_action_repair_start()
        </field>
  </record>

  <record id="action_repair_end_multiple" model="ir.actions.server">
    <field name="name">End repairs</field>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="model_id" ref="model_repair_order" />
    <field name="binding_model_id" ref="model_repair_order" />
    <field name="code">
if records:
    action = records.control_action_repair_end()
        </field>
  </record>

  <record id="action_confirm_repair_multiple" model="ir.actions.server">
    <field name="name">Confirm repairs</field>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="model_id" ref="model_repair_order" />
    <field name="binding_model_id" ref="model_repair_order" />
    <field name="code">
if records:
    action = records.control_action_validate()
        </field>
  </record>

  <record id="product_template_repair_action" model="ir.actions.act_window">
    <field name="name">Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="stock.product_template_search_form_view_stock" />
    <field name="domain">[('is_repair','=',True)]</field>
    <field
      name="context"
    >{"search_default_goods": 1, 'default_is_storable': True}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
            No product found. Let's create one!
        </p>
      <p>
            Track your stock quantities by creating storable products.
        </p>
    </field>
  </record>

  <record id="stock_product_repair_action" model="ir.actions.act_window">
    <field name="name">Product Variants</field>
    <field name="res_model">product.product</field>
    <field name="view_mode">list,form,kanban</field>
    <field name="search_view_id" ref="stock.stock_product_search_form_view" />
    <field name="domain">[('is_repair','=',True)]</field>
  </record>

  <record id="repair.repair_menu_product_template" model="ir.ui.menu">
    <field name="action" ref="product_template_repair_action" />
  </record>

  <record id="repair.repair_menu_product_product" model="ir.ui.menu">
    <field name="action" ref="stock_product_repair_action" />
  </record>
</odoo>
