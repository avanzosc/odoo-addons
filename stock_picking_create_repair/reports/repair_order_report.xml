<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template
    id="report_repairorder_inh_pick_create_repair"
    inherit_id="repair.report_repairorder"
  >
    <xpath expr="//div[hasclass('page')]" position="attributes">
      <attribute name="t-if">not o.sale_id</attribute>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="before">
      <t t-if="o.sale_id">
        <t t-set="information_block">
          <strong
            t-if="o.address_id == o.partner_invoice_id"
          >Invoice and shipping address:</strong>
          <div t-if="o.partner_invoice_id">
            <strong
              t-if="o.address_id != o.partner_invoice_id"
            >Invoice address: </strong>
            <div
              t-field="o.partner_invoice_id"
              t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
            />
            <p t-if="o.partner_invoice_id.vat">
              <t
              t-out="o.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"
            />:
              <span t-field="o.partner_invoice_id.vat" />
            </p>
          </div>
          <t t-if="o.address_id != o.partner_invoice_id">
            <strong>Shipping address:</strong>
            <div
              t-field="o.address_id"
              t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
            />
            <p t-if="o.address_id.vat">
              <t
              t-out="o.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"
            />:
              <span t-field="o.address_id.vat" />
            </p>
          </t>
        </t>
        <t t-set="address">
          <div
            t-field="o.partner_id"
            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
          />
        </t>
      </t>
    </xpath>
    <xpath expr="//div[hasclass('page')]" position="after">
      <div class="page" t-if="o.sale_id">
        <h2>
          <span t-if="o.state != 'draft'">Repair Order #:</span>
          <span t-if="o.state == 'draft'">Repair Quotation #:</span>
          <span t-field="o.name" />
        </h2>
        <div id="informations_repair" class="row mt32 mb32">
          <div t-if="o.product_id" class="col-3 bm-2">
            <strong>Product to Repair:</strong>
            <p t-field="o.product_id.name" class="m-0" />
          </div>
          <div class="col-3 bm-2" groups="stock.group_production_lot">
            <strong>Lot/Serial Number:</strong>
            <p t-if="o.lot_id" t-field="o.lot_id.name" class="m-0" />
          </div>
          <div class="col-3 bm-2">
            <strong>Printing Date:</strong>
            <p
              t-out="context_timestamp(datetime.datetime.now()).date()"
              t-options="{'widget': 'date'}"
              class="m-0"
            />
          </div>
        </div>
        <table class="table table-sm o_main_table">
          <thead>
            <tr>
              <th>Description</th>
              <th class="text-end">Quantity</th>
              <th class="text-end">Unit Price</th>
              <th class="text-center">Tax</th>
              <th class="text-end">Price</th>
            </tr>
          </thead>
          <tbody>
            <t t-if="o.move_ids">
              <tr class="bg-200 o_line_section">
                <td colspan="5">
                  <strong>Parts</strong>
                </td>
              </tr>
              <tr t-foreach="o.move_ids" t-as="line">
                <td>
                  <i t-if="line.repair_line_type == 'add'">(Add)</i>
                  <i t-if="line.repair_line_type == 'remove'">(Remove)</i>
                  <i t-if="line.repair_line_type == 'recycle'">(Recycle)</i>
                  <span t-field="line.product_id.display_name" />
                  <div
                    t-if="line.product_id.description_sale"
                    t-field="line.product_id.description_sale"
                  />
                </td>
                <td class="text-end">
                  <span t-field="line.product_uom_qty" />
                  <span groups="uom.group_uom" t-field="line.product_uom.name" />
                </td>
                <td class="text-end">
                  <span t-field="line.price_unit" />
                </td>
                <td class="text-center">
                  <span t-out="', '.join(line.tax_ids.mapped('name'))" />
                </td>
                <td class="text-end o_price_total">
                  <span
                    t-field="line.price_subtotal"
                    t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'
                  />
                </td>
              </tr>
            </t>
            <t t-if="o.repair_service_ids">
              <tr class="bg-200 o_line_section">
                <td colspan="5">
                  <strong>Operations</strong>
                </td>
              </tr>
              <tr t-foreach="o.repair_service_ids" t-as="service">
                <td>
                  <span t-if="service.product_id.default_code">[<t
                    t-out="service.product_id.default_code"
                  />]</span>
                  <span t-field="service.display_name" />
                  <div
                    t-if="service.product_id.description_sale"
                    t-field="service.product_id.description_sale"
                  />
                </td>
                <td class="text-end">
                  <span t-field="service.product_uom_qty" />
                  <span groups="uom.group_uom" t-field="service.product_uom.name" />
                </td>
                <td class="text-end">
                  <span t-field="service.price_unit" />
                </td>
                <td class="text-center">
                  <span t-out="', '.join(service.tax_ids.mapped('name'))" />
                </td>
                <td class="text-end o_price_total">
                  <span
                    t-field="service.price_subtotal"
                    t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'
                  />
                </td>
              </tr>
            </t>
          </tbody>
        </table>
        <div id="total_repair" class="row justify-content-end">
          <div class="col-4">
            <table class="table table-sm">
              <tr class="border-black o_subtotal">
                <td>
                  <strong>Total Without Taxes</strong>
                </td>
                <td class="text-end">
                  <span
                    t-field="o.lines_amount_untaxed"
                    t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'
                  />
                </td>
              </tr>
              <tr>
                <td>Taxes</td>
                <td class="text-end o_price_total">
                  <span
                    t-field="o.lines_amount_tax"
                    t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'
                  />
                </td>
              </tr>
              <tr class="border-black o_total">
                <td>
                  <strong>Total</strong>
                </td>
                <td class="text-end o_price_total">
                  <span
                    t-field="o.lines_amount_total"
                    t-options='{"widget": "monetary", "display_currency": o.company_currency_id}'
                  />
                </td>
              </tr>
            </table>
          </div>
        </div>
        <div t-if="o.internal_notes" t-field="o.internal_notes" />
      </div>
    </xpath>
  </template>
</odoo>
