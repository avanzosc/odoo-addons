<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='invoice_line_ids']/list/field[@name='product_uom_id']"
        position="after"
      >
        <field name="total_weight_qty" optional="show" sum="Total Weight" />
        <field name="weight_uom_name" />
      </xpath>
      <field name="invoice_vendor_bill_id" position="after">
        <field name="total_weight_qty" />
      </field>
    </field>
  </record>

  <record id="view_invoice_tree" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree" />
    <field name="arch" type="xml">
      <field name="amount_untaxed_in_currency_signed" position="after">
        <field name="total_weight_qty" optional="show" sum="Total Weight" />
      </field>
    </field>
  </record>
</odoo>
