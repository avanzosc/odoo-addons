<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.custom_display_name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[2]" position="inside">
                <field name="custom_display_name" />
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_tree_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.inherit.custom_display_name</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="custom_display_name" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
