<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_account_invoice_report_pivot_payment_days" model="ir.ui.view">
    <field name="name">account.invoice.report.pivot.payment.days</field>
    <field name="model">account.invoice.report</field>
    <field name="inherit_id" ref="account.view_account_invoice_report_pivot" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='price_subtotal']" position="after">
        <field name="days_until_payment" type="measure" string="Days Until Payment" />
      </xpath>
    </field>
  </record>
</odoo>
