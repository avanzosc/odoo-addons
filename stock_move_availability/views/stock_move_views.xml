<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_tree" model="ir.ui.view">
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_tree" />
    <field name="arch" type="xml">
      <field name="product_uom_qty" position="after">
        <field name="product_uom_category_id" invisible="1" />
        <field name="product_qty" invisible="1" readonly="1" />
        <field name="availability" invisible="1" />
        <field name="forecast_expected_date" invisible="1" />
        <field
          name="forecast_availability"
          string="Forecast"
          widget="forecast_widget"
          optional="hide"
        />
        <field name="show_check_availability" invisible="1" />
        <field name="picking_code" invisible="1" />
        <field name="move_type" invisible="1" />
        <button
          name="button_action_assign"
          string="Check Availability"
          invisible="show_check_availability == False or state in ['assigned', 'done', 'cancel']"
          icon="fa-check"
          type="object"
          groups="base.group_user"
        />
        <button
          name="button_do_unreserve"
          string="Unreserve"
          groups="base.group_user"
          type="object"
          invisible="picking_code == 'incoming' or state not in ['assigned', 'partially_available']"
        />
      </field>
    </field>
  </record>
</odoo>
