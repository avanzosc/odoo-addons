<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
        position="after"
      >
        <field name="product_default_code" optional="show" />
      </xpath>
      <field name="invoice_origin" position="replace" />
      <field name="partner_shipping_id" position="after">
        <field name="invoice_origin" />
      </field>
      <button name="open_created_caba_entries" position="after">
        <button
          name="action_view_stock_valuation_layer"
          type="object"
          class="oe_stat_button"
          invisible="count_stock_valuation_layer == 0"
          icon="fa-tasks"
        >
          <field
            name="count_stock_valuation_layer"
            widget="statinfo"
            string="Stock Valuation Layer"
          />
        </button>
      </button>
    </field>
  </record>

  <record id="view_invoice_tree" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree" />
    <field name="arch" type="xml">
      <field name="invoice_origin" position="attributes">
        <attribute name="optional">show</attribute>
      </field>
      <field name="invoice_date_due" position="attributes">
        <attribute name="widget" />
        <attribute name="invisible">False</attribute>
      </field>
    </field>
  </record>

  <record id="view_account_invoice_filter" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="arch" type="xml">
      <field name="invoice_user_id" position="after">
        <field
          name="invoice_line_ids"
          string="Product/Line description"
          filter_domain="['|', ('invoice_line_ids.product_id', 'ilike', self), ('invoice_line_ids.name', 'ilike', self)]"
        />
      </field>
      <filter name="out_refund" position="after">
        <separator />
        <filter
          name="with_stock_valuation_layer"
          string="With Stock Valuation"
          domain="[('count_stock_valuation_layer', '>', 0)]"
        />
        <filter
          name="without_stock_valuation_layer"
          string="Without Stock Valuation"
          domain="[('count_stock_valuation_layer', '=', 0)]"
        />
      </filter>
    </field>
  </record>

  <record id="action_put_invoice_to_draft" model="ir.actions.server">
    <field name="name">Convert draft to invoice</field>
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="model_id" ref="account.model_account_move" />
    <field name="binding_model_id" ref="account.model_account_move" />
    <field name="code">
            for record in records:
                record.button_draft()
        </field>
  </record>
</odoo>
