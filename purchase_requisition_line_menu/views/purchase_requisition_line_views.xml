<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="purchase_requisition_line_tree_view">
        <field name="name">purchase.requisition.line.tree.view</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="requisition_id" optional="show" />
                <field name="user_id" optional="show" widget='many2one_avatar_user' />
                <field name="product_id" optional="show" />
                <field name="vendor_id" optional="show" />
                <field
          name="company_id"
          groups="base.group_multi_company"
          optional="show"
        />
                <field name="product_description_variants" optional="show" />
                <field name="product_qty" optional="hide" />
                <field name="qty_ordered" optional="hide" />
                <field name="price_unit" optional="hide" />
                <field name="ordering_date" optional="show" />
                <field name="schedule_date" optional="show" />
                <field name="date_end" optional="show" />
                <field name="state" optional="show" />
            </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="purchase_requisition_line_form_view">
        <field name="name">purchase.requisition.line.form.view</field>
        <field name="model">purchase.requisition.line</field>
        <field name="arch" type="xml">
            <form string="Purchase Line Agreements">
            <header>
                <field
            name="state"
            widget="statusbar"
            statusbar_visible="draft,ongoing,in_progress,open,done,cancel"
          />
            </header>
            <sheet>
                <div class="oe_title">
                    <label for="requisition_id" class="oe_inline" />
                    <h1>
                        <field name="requisition_id" readonly="1" />
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="vendor_id" readonly="1" />
                        <field name="product_id" readonly="1" />
                        <field name="user_id" readonly="1" />
                        <field name="product_description_variants" readonly="1" />
                    </group>
                    <group>
                        <field name="date_end" readonly="1" />
                        <field name="ordering_date" readonly="1" />
                        <field name="schedule_date" readonly="1" />
                        <field name="company_id" readonly="1" />
                    </group>
                </group>
            </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_requisition_line_search_view" model="ir.ui.view">
            <field name="name">purchase.requisition.line.search.view</field>
            <field name="model">purchase.requisition.line</field>
            <field name="arch" type="xml">
                <search string="Search Purchase Line Agreements">
                    <field name="requisition_id" />
                    <field name="user_id" />
                    <field name="vendor_id" />
                    <field name="product_id" />
                    <separator />
                    <filter
          string="My Agreements"
          name="my_agreements"
          domain="[('user_id', '=', uid)]"
        />
                    <separator />
                    <filter
          string="Draft"
          name="draft"
          domain="[('state', '=', 'draft')]"
          help="New Agreements"
        />
                    <filter
          string="Confirmed"
          name="confirmed"
          domain="[('state', 'in', ('in_progress', 'open'))]"
          help="In negotiation"
        />
                    <filter
          string="Done"
          name="done"
          domain="[('state', '=', 'done')]"
        />
                    <group expand="0" string="Group By">
                        <filter
            string="Reference"
            name="requisition"
            domain="[]"
            context="{'group_by': 'requisition_id'}"
          />
                        <filter
            string="Purchase Representative"
            name="representative"
            domain="[]"
            context="{'group_by': 'user_id'}"
          />
                        <filter
            string="Vendor"
            name="vendor"
            domain="[]"
            context="{'group_by': 'vendor_id'}"
          />
                        <filter
            string="Product"
            name="product"
            domain="[]"
            context="{'group_by': 'product_id'}"
          />
                        <filter
            string="Status"
            name="status"
            domain="[]"
            context="{'group_by': 'state'}"
          />
                        <filter
            string="Ordering Date"
            name="ordering_date"
            domain="[]"
            context="{'group_by': 'ordering_date'}"
          />
                    </group>
                </search>
            </field>
        </record>

    <record model="ir.actions.act_window" id="action_purchase_requisition_line">
        <field name="name">Blanket Orders Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.requisition.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="purchase_requisition_line_search_view" />
    </record>

    <menuitem
    id="menu_purchase_requisition_line_pro_mgt"
    sequence="11"
    parent="purchase.menu_procurement_management"
    action="action_purchase_requisition_line"
  />
</odoo>
