<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_inventory_transfer_view_tree" model="ir.ui.view">
        <field name="model">stock.inventory.transfer</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'done'" decoration-bf="state == 'pass'">
                <field name="name"/>
                <field name="file_date"/>
                <field name="state"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="stock_inventory_transfer_view_form" model="ir.ui.view">
        <field name="model">stock.inventory.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_file" string="Import" type="object" class="oe_read_only" states="draft,2validate,pass,error"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_read_only" states="2validate,pass,error"/>
                    <button name="action_process" string="Process" type="object" class="oe_read_only" states="pass,error"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button string="Import Lines" type="object" name="button_open_import_line"
                                attrs="{'invisible':[('import_line_ids', '=', [])]}" class="oe_stat_button" icon="fa-bars"/>
                        <button type="object" name="button_open_stock_move"
                                attrs="{'invisible':[('stock_move_count', '=', 0)]}"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="stock_move_count" widget="statinfo" />
                        </button>
                        <button type="object" name="button_open_stock_picking"
                                attrs="{'invisible':[('stock_picking_count', '=', 0)]}"
                                class="oe_stat_button" icon="fa-folder-open">
                            <field name="stock_picking_count" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="filename"/>
                            <field name="data" filename="filename"/>
                            <field name="file_date"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="picking_type_id" />
                            <field name="location_src_id" />
                            <field name="location_dst_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Imported Lines">
                            <field name="import_line_ids" />
                        </page>
                        <page string="Error Log" attrs="{'invisible':[('log_info','=','')]}">
                            <field name="log_info"/>
                        </page>
                        <page string="Help" attrs="{'invisible': [('state', '=', 'done')]}">
                            <group>
                                <div name="help" style="margin-top: 4px;">
                                    <h3>Help with Excel column names</h3>
                                    <p>You must use this column names in order to fill the table:</p>
                                    <ul>
                                        <li><code>producto</code>: this will fill <b>Supplier Name.</b></li>
                                        <li><code>lista</code>: this will fill <b>Product Code.</b></li>
                                        <li><code>cantidad</code>: this will fill <b>Product Qty.</b></li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="stock_inventory_transfer_view_search" model="ir.ui.view">
        <field name="model">stock.inventory.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]"/>
                <filter name="finished" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="errored" string="Error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state_group" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_inventory_transfer_action" model="ir.actions.act_window">
        <field name="name">Stock Inventory Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.inventory.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="stock_inventory_transfer_view_tree"/>
    </record>

    <menuitem id="stock_inventory_transfer_menu"
              action="stock_inventory_transfer_action"
              parent="base_import_wizard.base_import_menu"
              sequence="10"/>

</odoo>
