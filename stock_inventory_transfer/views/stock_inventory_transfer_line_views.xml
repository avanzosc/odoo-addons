<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_inventory_transfer_line_view_form" model="ir.ui.view">
        <field name="model">stock.inventory.transfer.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_validate" string="Validate" type="object" class="oe_read_only" states="2validate,error,pass"/>
                    <button name="button_process" string="Process" type="object" class="oe_read_only" states="error,pass"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_code" />
                            <field name="product_name" />
                            <field name="product_barcode" />
                        </group>
                        <group>
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <field name="log_info"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_inventory_transfer_line_view_tree" model="ir.ui.view">
        <field name="model">stock.inventory.transfer.line</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'error'" decoration-muted="state == 'done'" decoration-it="log_info" editable="top">
                <field name="import_id" invisible="context.get('import_hide', True)" />
                <field name="action" />
                <field name="product_code" />
                <field name="product_name" />
                <field name="product_barcode" />
                <field name="product_id" invisible="context.get('import_hide', True)" options="{'no_create': True}" />
                <field name="product_qty" />
                <field name="state" readonly="1" invisible="1"/>
                <field name="log_info" readonly="1" invisible="context.get('import_hide', True)"/>
                <button
          name="action_open_form"
          type="object"
          title="Open form view"
          icon="fa-external-link"
        />
                <button
          name="button_validate"
          type="object"
          title="Validate"
          icon="fa-search"
          states="2validate,pass,error"
        />
                <button
          name="button_process"
          type="object"
          title="Process"
          icon="fa-check"
          states="pass"
        />
            </tree>
        </field>
    </record>

    <record id="stock_inventory_transfer_line_view_search" model="ir.ui.view">
        <field name="model">stock.inventory.transfer.line</field>
        <field name="arch" type="xml">
            <search>
                <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]"/>
                <filter name="finished" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="errored" string="Error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="To Update" name="2update" domain="[('action', '=', 'update')]"/>
                <filter string="To Create" name="2create" domain="[('action', '=', 'create')]"/>
                <filter string="Do Nothing" name="do_nothing" domain="[('action', '=', 'nothing')]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="product_group" domain="[]"
                            context="{'group_by':'product_id'}"/>
                    <separator/>
                    <filter string="Status" name="group_status" context="{'group_by': 'state'}"/>
                    <filter string="Action" name="group_action" context="{'group_by':'action'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_inventory_transfer_line_action" model="ir.actions.act_window">
        <field name="name">Stock Inventory Transfer Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.inventory.transfer.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'import_hide': False}</field>
        <field name="view_id" ref="stock_inventory_transfer_line_view_tree"/>
    </record>

    <record id="action_validate_line" model="ir.actions.server">
        <field name="name">Validate</field>
        <field name="model_id" ref="model_stock_inventory_transfer_line"/>
        <field name="binding_model_id" ref="model_stock_inventory_transfer_line"/>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record.button_validate()
        </field>
    </record>

    <record id="action_process_line" model="ir.actions.server">
        <field name="name">Process</field>
        <field name="model_id" ref="model_stock_inventory_transfer_line"/>
        <field name="binding_model_id" ref="model_stock_inventory_transfer_line"/>
        <field name="state">code</field>
        <field name="code">
            for record in records:
                record.button_process()
        </field>
    </record>
</odoo>
