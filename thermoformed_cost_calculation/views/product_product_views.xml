<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_product_view_form" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="sale.product_form_view_sale_order_button" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                    <button
          class="oe_stat_button"
          name="button_open_thermoformed_cost"
          type="object"
          icon="fa-usd"
        >
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field
                name="thermoformed_count"
                widget="statinfo"
                nolabel="1"
                class="mr4"
              />
                            </span>
                            <span class="o_stat_text">Thermoformed</span>
                        </div>
                    </button>
                </div>
        </field>
    </record>
</odoo>
