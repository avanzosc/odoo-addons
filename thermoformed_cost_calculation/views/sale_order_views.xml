<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_offer_version.sale_order_offer_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//sheet/group/group/field[@name='partner_id']"
        position="after"
      >
                <field
          name="thermoformed_id"
          attrs="{'invisible': [('is_offer_type', '!=', True)]}"
        />
            </xpath>
        </field>
    </record>
</odoo>
