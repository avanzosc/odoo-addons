<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <record id="saca_pdf_send" model="mail.template">
    <field name="name">Send saca PDF</field>
    <field
      name="email_from"
    >{{ (object.supplier_id.email and '%s &lt;%s&gt;' % (object.supplier_id.name, object.supplier_id.email)) or '' }}</field>
    <field
      name="subject"
    >{{ object.supplier_id.name }} Saca (Lote {{ object.lot or 'n/a' }})</field>
    <field name="partner_to">{{ object.farm_id.id }}</field>
    <field name="model_id" ref="model_saca_line" />
    <field name="auto_delete" eval="True" />
    <field name="report_template_ids" eval="[(4, ref('action_report_driver_saca'))]" />
    <field name="lang">{{ object.supplier_id.lang }}</field>
    <field
      name="body_html"
    ><![CDATA[
<div style="font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">
<p>Hello <t t-out="object.farm_id.name or ''"></t>,</p>
<p>A new saca has been done: </p>

<p style="border-left: 1px solid #8e0000; margin-left: 30px;">
&nbsp;&nbsp;<strong>GENERAL INFO</strong><br />
&nbsp;&nbsp;Lot: <strong><t t-out="object.lot"></t></strong><br />
&nbsp;&nbsp;Date Saca: <t t-out="object.date or ''"></t><br />
&nbsp;&nbsp;Driver: <t t-out="object.driver_id.name or ''"></t><br />
&nbsp;&nbsp;Farm: <t t-out="object.farm_id.name or ''"></t><br />

You can find the file containing more information on the attachments.
</p>

<br/>
<p>If you have any questions, do not hesitate to contact us.</p>
<br/>
<br/>
<div style="width: 375px; margin: 0px; padding: 0px; background-color: #8E0000; border-top-left-radius: 5px 5px; border-top-right-radius: 5px 5px; background-repeat: repeat no-repeat;">
<h3 style="margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;">
<strong style="text-transform:uppercase;"><t t-out="object.supplier_id.name"></t></strong></h3>
</div>
<div style="width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #F2F2F2;">
<span style="color: #222; margin-bottom: 5px; display: block; ">
<t t-out="object.supplier_id.sudo().with_context(show_address=True).display_name"></t>
</span>
<t t-if="object.supplier_id.phone">
<div style="margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; ">
Phone: <t t-out="object.supplier_id.phone"></t>
</div>
</t>
<t t-if="object.supplier_id.website">
<div>
Web: <a t-att-href="object.supplier_id.website"><t t-out="object.supplier_id.website"></t></a>
</div>
</t>
<p></p>
</div>
<p></p>
</div>
]]></field>
  </record>
</odoo>
