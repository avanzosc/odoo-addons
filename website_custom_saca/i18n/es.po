#. module: website_custom_saca
#: model:mail.template,body_html:website_custom_saca.saca_pdf_send
msgid ""
"<div style=\"font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; \">\n"
"<p>Hello <t t-out=\"object.farm_id.name or ''\"/>,</p>\n"
"<p>A new saca has been done: </p>\n"
"\n"
"<p style=\"border-left: 1px solid #8e0000; margin-left: 30px;\">\n"
"&nbsp;&nbsp;<strong>GENERAL INFO</strong><br/>\n"
"&nbsp;&nbsp;Lot: <strong><t t-out=\"object.lot\"/></strong><br/>\n"
"&nbsp;&nbsp;Date Saca: <t t-out=\"object.date or ''\"/><br/>\n"
"&nbsp;&nbsp;Driver: <t t-out=\"object.driver_id.name or ''\"/><br/>\n"
"&nbsp;&nbsp;Farm: <t t-out=\"object.farm_id.name or ''\"/><br/>\n"
"\n"
"You can find the file containing more information on the attachments.\n"
"</p>\n"
"\n"
"<br/>\n"
"<p>If you have any questions, do not hesitate to contact us.</p>\n"
"<br/>\n"
"<br/>\n"
"<div style=\"width: 375px; margin: 0px; padding: 0px; background-color: #8E0000; border-top-left-radius: 5px 5px; border-top-right-radius: 5px 5px; background-repeat: repeat no-repeat;\">\n"
"<h3 style=\"margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;\">\n"
"<strong style=\"text-transform:uppercase;\"><t t-out=\"object.supplier_id.name\"/></strong></h3>\n"
"</div>\n"
"<div style=\"width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #F2F2F2;\">\n"
"<span style=\"color: #222; margin-bottom: 5px; display: block; \">\n"
"<t t-out=\"object.supplier_id.sudo().with_context(show_address=True).display_name\"/>\n"
"</span>\n"
"<t t-if=\"object.supplier_id.phone\">\n"
"<div style=\"margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"Phone: <t t-out=\"object.supplier_id.phone\"/>\n"
"</div>\n"
"</t>\n"
"<t t-if=\"object.supplier_id.website\">\n"
"<div>\n"
"Web: <a t-att-href=\"object.supplier_id.website\"><t t-out=\"object.supplier_id.website\"/></a>\n"
"</div>\n"
"</t>\n"
"<p/>\n"
"</div>\n"
"<p/>\n"
"</div>\n"
msgstr ""
"<div style=\"font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; \">\n"
"<p>Hola <t t-out=\"object.farm_id.name or ''\"/>,</p>\n"
"<p>Se ha realizado una nueva saca: </p>\n"
"\n"
"<p style=\"border-left: 1px solid #8e0000; margin-left: 30px;\">\n"
"&nbsp;&nbsp;<strong>INFORMACIÓN GENERAL</strong><br/>\n"
"&nbsp;&nbsp;Lote: <strong><t t-out=\"object.lot\"/></strong><br/>\n"
"&nbsp;&nbsp;Fecha Saca: <t t-out=\"object.date or ''\"/><br/>\n"
"&nbsp;&nbsp;Conductor: <t t-out=\"object.driver_id.name or ''\"/><br/>\n"
"&nbsp;&nbsp;Granja: <t t-out=\"object.farm_id.name or ''\"/><br/>\n"
"\n"
"Puede encontrar el archivo con más información en los adjuntos.\n"
"</p>\n"
"\n"
"<br/>\n"
"<p>Si tiene alguna pregunta, no dude en contactarnos.</p>\n"
"<br/>\n"
"<br/>\n"
"<div style=\"width: 375px; margin: 0px; padding: 0px; background-color: #8E0000; border-top-left-radius: 5px 5px; border-top-right-radius: 5px 5px; background-repeat: repeat no-repeat;\">\n"
"<h3 style=\"margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;\">\n"
"<strong style=\"text-transform:uppercase;\"><t t-out=\"object.supplier_id.name\"/></strong></h3>\n"
"</div>\n"
"<div style=\"width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #F2F2F2;\">\n"
"<span style=\"color: #222; margin-bottom: 5px; display: block; \">\n"
"<t t-out=\"object.supplier_id.sudo().with_context(show_address=True).display_name\"/>\n"
"</span>\n"
"<t t-if=\"object.supplier_id.phone\">\n"
"<div style=\"margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"Teléfono: <t t-out=\"object.supplier_id.phone\"/>\n"
"</div>\n"
"</t>\n"
"<t t-if=\"object.supplier_id.website\">\n"
"<div>\n"
"Web: <a t-att-href=\"object.supplier_id.website\"><t t-out=\"object.supplier_id.website\"/></a>\n"
"</div>\n"
"</t>\n"
"<p/>\n"
"</div>\n"
"<p/>\n"
"</div>\n"

