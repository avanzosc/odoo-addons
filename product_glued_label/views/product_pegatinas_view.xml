<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_pegatinas_form_view">
        <field name="name">product.product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <page name="general_information" position="inside">
                <group name="images" string="Box stickers">
                    <group>
                        <field string="Small Box" name="codigobarras" widget="image" />
                    </group>
                    <group>
                        <field string="Big Box" name="pegatinacaja" widget="image" />
                    </group>
                </group>
            </page>
        </field>
    </record>
</odoo>
