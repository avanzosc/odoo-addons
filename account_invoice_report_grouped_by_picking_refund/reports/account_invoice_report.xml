<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
    id="report_invoice_document"
    inherit_id="account_invoice_report_grouped_by_picking.report_invoice_document"
    priority="100"
  >
        <t t-if="picking != last_picking" position="attributes">
            <attribute
        name="t-if"
      >picking != last_picking and o.move_type not in ('out_refund','out_receipt')</attribute>
        </t>
        <tr t-if="picking != next_picking[0]" position="attributes">
            <attribute
        name="t-if"
      >picking != next_picking[0] and o.move_type not in ('out_refund','out_receipt')</attribute>
        </tr>
    </template>
</odoo>
