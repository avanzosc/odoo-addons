<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="account_move_import_line_view_search" model="ir.ui.view">
    <field name="model">account.move.import.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="account_code" />
        <field name="name" />
        <field name="partner_ref" />
        <field name="partner_name" />
        <separator />
        <filter string="Errored" name="error" domain="[('state', '=', 'error')]" />
        <separator />
        <filter string="Create" name="create" domain="[('action', '=', 'create')]" />
        <filter
          string="Do Nothing"
          name="do_nothing"
          domain="[('action', '=', 'nothing')]"
        />
        <group expand="0" name="group_by" string="Group By">
          <filter
            name="group_account_id"
            string="Account"
            context="{'group_by': 'account_id'}"
          />
          <filter
            name="group_partner"
            string="Partner"
            context="{'group_by': 'partner_id'}"
          />
          <separator />
          <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
          <filter
            string="Action"
            name="action_group"
            domain="[]"
            context="{'group_by':'action'}"
          />
          <filter
            string="Log Info"
            name="log_info_group"
            domain="[]"
            context="{'group_by':'log_info'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="account_move_import_line_view_form" model="ir.ui.view">
    <field name="model">account.move.import.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ['2validate', 'error']"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state not in ['pass']"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="account_code" />
              <field name="name" />
              <field name="partner_ref" />
              <field name="partner_name" />
              <field name="debit" />
              <field name="credit" />
            </group>
            <group>
              <field name="account_id" options="{'no_create': True, 'no_open': True}" />
              <field name="partner_id" options="{'no_create': True, 'no_open': True}" />
              <field
                name="account_move_id"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <field name="log_info" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="account_move_import_line_view_tree" model="ir.ui.view">
    <field name="model">account.move.import.line</field>
    <field name="arch" type="xml">
      <list
        decoration-danger="state == 'error'"
        decoration-muted="state == 'done'"
        decoration-it="log_info"
        editable="top"
      >
        <field
          name="action"
          decoration-muted="action == 'nothing'"
          decoration-info="action == 'create'"
          readonly="state == 'done'"
          optional="hide"
        />
        <field name="account_code" readonly="state == 'done'" />
        <field name="name" readonly="state == 'done'" />
        <field name="account_id" optional="hide" readonly="state == 'done'" />
        <field name="partner_ref" readonly="state == 'done'" optional="show" />
        <field name="partner_name" readonly="state == 'done'" optional="show" />
        <field name="partner_id" optional="hide" readonly="state == 'done'" />
        <field name="debit" sum="Total Debit" readonly="state == 'done'" />
        <field name="credit" sum="Total Credit" readonly="state == 'done'" />
        <field name="state" optional="show" readonly="state == 'done'" />
        <field name="log_info" optional="show" readonly="state == 'done'" />
      </list>
    </field>
  </record>

  <record id="account_move_import_line_action" model="ir.actions.act_window">
    <field name="name">Import Account Move Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">account.move.import.line</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="account_move_import_line_view_tree" />
  </record>
</odoo>
