<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="account_move_import_view_tree" model="ir.ui.view">
    <field name="model">account.move.import</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'done'" decoration-bf="state == 'pass'">
        <field name="name" />
        <field name="file_date" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="account_move_import_view_form" model="ir.ui.view">
    <field name="model">account.move.import</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_import_file"
            string="Import"
            type="object"
            invisible="state not in ['draft', '2validate', 'pass', 'error']"
          />
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ['2validate', 'error']"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state not in ['pass']"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              invisible="not import_line_ids"
              class="oe_stat_button"
              icon="fa-bars"
            />
            <button
              type="object"
              name="button_open_account_move"
              string="Account Move"
              invisible="not account_move_id"
              class="oe_stat_button"
              icon="fa-folder-open"
            >
              <field name="account_move_id" invisible="1" />
            </button>
          </div>
          <group>
            <group string="Import Data">
              <field name="filename" readonly="state == 'done'" />
              <field name="data" filename="filename" readonly="state == 'done'" />
              <field name="file_date" readonly="state == 'done'" />
              <field
                name="company_id"
                groups="base.group_multi_company"
                options="{'no_create': True}"
                readonly="state == 'done'"
              />
              <field name="search_partner_by_ref" readonly="state == 'done'" />
            </group>
            <group string="Account Move Information">
              <field name="ref" readonly="state == 'done'" />
              <field name="accounting_date" readonly="state == 'done'" />
              <field
                name="journal_id"
                domain="[('company_id', '=', company_id)]"
                options="{'no_create': True}"
                readonly="state == 'done'"
              />
              <field name="account_move_id" invisible="1" />
            </group>
          </group>
          <notebook>
            <page string="Imported Lines">
              <field name="import_line_ids" readonly="state == 'done'" />
            </page>
            <page
              string="⚠ Error Log"
              name="error_log_page"
              class="account_move_import_error_tab"
              invisible="not log_info"
            >
              <field name="log_info" />
            </page>
            <page string="Help" name="help_page" invisible="state == 'done'">
              <group>
                <div style="margin-top: 4px;">
                  <h3>Help with Excel column names</h3>
                  <p>You must use this column names in order to fill the table:</p>
                  <ul name="tutorial">
                    <li>
                                            <code>Account</code>: this will fill <b
                    >Account Code</b>
                                        </li>
                    <li>
                                            <code>Name</code>: this will fill <b
                    >Label</b>
                                        </li>
                    <li>
                                            <code>Partner Code</code>: this will fill <b
                    >Partner Reference</b>
                                        </li>
                    <li>
                                            <code>Partner Name</code>: this will fill <b
                    >Partner Name</b>
                                        </li>
                    <li>
                                            <code>Debit</code>: this will fill <b
                    >Debit</b>
                                        </li>
                    <li>
                                            <code>Credit</code>: this will fill <b
                    >Credit</b>
                                        </li>
                  </ul>
                </div>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="account_move_import_view_search" model="ir.ui.view">
    <field name="model">account.move.import</field>
    <field name="arch" type="xml">
      <search>
        <field name="file_date" />
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <group expand="0" string="Group By">
          <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="account_move_import_action" model="ir.actions.act_window">
    <field name="name">Import Account Moves</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">account.move.import</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="account_move_import_view_tree" />
  </record>

  <menuitem
    id="account_move_import_menu"
    action="account_move_import_action"
    parent="base_import_wizard.base_import_menu"
    sequence="10"
  />

  <menuitem
    id="account_move_import_contact_menu"
    action="account_move_import_action"
    parent="account.menu_analytic_accounting"
    sequence="15"
  />
</odoo>
