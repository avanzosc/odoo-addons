<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="qc_inspection_line_tree_view" model="ir.ui.view">
        <field name="model">qc.inspection.line</field>
        <field
      name="inherit_id"
      ref="quality_control_oca.qc_inspection_line_tree_view"
    />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="reference" readonly="1" />
            </field>
        </field>
    </record>

    <record id="qc_inspection_line_search_view" model="ir.ui.view">
        <field name="model">qc.inspection.line</field>
        <field
      name="inherit_id"
      ref="quality_control_oca.qc_inspection_line_search_view"
    />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="reference" />
            </field>
        </field>
    </record>
</odoo>
