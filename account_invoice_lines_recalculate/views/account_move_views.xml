<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="account_invoice_line_recalculate_form" model="ir.ui.view">
    <field name="name">account.move.form.recalculate.invoice.lines</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="active" eval="True" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='invoice_line_ids']/list/field[@name='currency_id']"
        position="after"
      >
        <field name="product_discount_percentage" invisible="1" />
        <field name="product_exclude_discount_categ" invisible="1" />
        <button
          name="recalculate_invoice_line"
          type="object"
          string="Recalculate"
          invisible="parent.state != 'draft' or not product_exclude_discount_categ or product_discount_percentage == 0"
        />
      </xpath>
    </field>
  </record>
</odoo>
