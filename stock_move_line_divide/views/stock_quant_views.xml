<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_quant_tree_partner_on_package" model="ir.ui.view">
    <field name="name">stock.quant.tree.partner.on.package</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='owner_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath
        expr="//tree/field[@name='package_id' and @groups='stock.group_tracking_lot']"
        position="after"
      >
        <field name="partner_id" string="Partner (package)" />
      </xpath>

    </field>
  </record>

  <record id="view_stock_quant_tree_editable_partner_on_package" model="ir.ui.view">
    <field name="name">stock.quant.tree.edit.partner.on.package</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='owner_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath
        expr="//tree/field[@name='package_id' and @groups='stock.group_tracking_lot']"
        position="after"
      >
        <field name="partner_id" string="Partner (package)" />
      </xpath>
    </field>
  </record>
  <record
    id="view_stock_quant_tree_inventory_editable_inherit_partner"
    model="ir.ui.view"
  >
    <field name="name">stock.quant.tree.inventory.editable.inherit.partner</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='package_id']" position="after">
        <field
          name="partner_id"
          string="Partner"
          optional="show"
          groups="stock.group_tracking_lot"
          readonly="1"
        />
      </xpath>
    </field>
  </record>


</odoo>
