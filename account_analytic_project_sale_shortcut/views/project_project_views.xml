<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edit_project" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
          name="action_view_sale_orders_from_project"
          type="object"
          class="oe_stat_button"
          icon="fa-pencil-square-o"
          attrs="{'invisible': [('count_sale_order', '=', 0)]}"
        >
                    <field
            name="count_sale_order"
            widget="statinfo"
            string="Sale Orders"
          />
                </button>
            </div>
        </field>
    </record>

    <record id="view_project_kanban" model="ir.ui.view">
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <field name="last_update_color" position="after">
                <field name="count_sale_order" />
            </field>
            <xpath expr="//a[@name='action_view_tasks']/.." position="before">
                <div role="menuitem" t-if="record.count_sale_order.raw_value > 0">
                    <a
            name="action_view_sale_orders_from_project"
            type="object"
          >Sale Orders</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
