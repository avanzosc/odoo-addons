<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_move_line_view_search" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search" />
        <field name="arch" type="xml">
            <filter name="group_by_move_line_type" position="after">
                <filter
          string="Year"
          name="group_year"
          domain="[]"
          context="{'group_by': 'year'}"
        />
                <filter
          string="Month"
          name="group_month"
          domain="[]"
          context="{'group_by': 'month'}"
        />
                <filter
          string="Week"
          name="group_week"
          domain="[]"
          context="{'group_by': 'year_week'}"
        />
                <filter
          string="Weekday"
          name="group_weekday"
          domain="[]"
          context="{'group_by': 'weekday'}"
        />
                <filter
          string="Warehouse"
          name="group_by_warehouse"
          domain="[]"
          context="{'group_by': 'warehouse_id'}"
        />
            </filter>
        </field>
    </record>

    <record id="stock_move_line_pivot" model="ir.ui.view">
        <field name="name">stock.move.line.pivot</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_id" type="row" />
                <field name="weekday" type="row" />
                <field name="warehouse_id" type="col" />
                <field name="qty_done" type="measure" />
                <field name="min_qty" type="measure" />
            </pivot>
        </field>
    </record>

    <record id="stock.stock_move_line_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form,pivot</field>
    </record>
</odoo>
