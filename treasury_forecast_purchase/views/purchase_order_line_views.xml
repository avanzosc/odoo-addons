<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_purchase_order_line_tree_product_category" model="ir.ui.view">
    <field name="name">purchase.order.line.tree.product.category</field>
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_order_line_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_id']" position="after">
        <field name="product_category_id" optional="show" />
      </xpath>
    </field>
  </record>

  <record id="view_purchase_order_line_form_product_category" model="ir.ui.view">
    <field name="name">purchase.order.line.form.product.category</field>
    <field name="model">purchase.order.line</field>
    <field name="inherit_id" ref="purchase.purchase_order_line_form2" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_id']" position="after">
        <field name="product_category_id" readonly="1" />
      </xpath>
    </field>
  </record>
</odoo>
