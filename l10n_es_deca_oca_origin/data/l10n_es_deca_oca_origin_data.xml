<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="stock_location_deca_origin" model="stock.location">
    <field name="name">DECA Origin</field>
    <field name="usage">customer</field>
  </record>
  <record id="stock_location_deca_destination" model="stock.location">
    <field name="name">DECA Destination</field>
    <field name="usage">customer</field>
  </record>
  <record id="product_product_deca_transport" model="product.product">
    <field name="name">Transport</field>
    <field name="type">consu</field>
    <field name="sale_ok" eval="True" />
    <field name="purchase_ok" eval="False" />
    <field name="is_storable" eval="False" />
  </record>
</odoo>
