<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <page id="other_tab_entry" position="after">
        <page string="DeCA" name="deca_info" invisible="move_type != 'out_invoice'">
          <group>
            <group>
              <field name="tractor_license_plate_id" />
              <field name="trailer_license_plate_id" />
              <field name="carrier_contact_id" />
            </group>
            <group>
              <field name="special_authorization" widget="text" />
              <field name="deca_weight" />
            </group>
          </group>
          <separator string="DECA Notes" colspan="4" />
          <field name="deca_notes" colspan="4" nolabel="1" widget="text" />
        </page>
      </page>
      <xpath
        expr="//field[@name='invoice_line_ids']/list/field[@name='account_id']"
        position="before"
      >
        <field
          name="place_of_loading_id"
          optional="show"
          context="{'show_city': True}"
          column_invisible="parent.move_type != 'out_invoice'"
        />
        <field
          name="place_of_delivery_ids"
          widget="many2many_tags"
          optional="show"
          context="{'show_city': True}"
          column_invisible="parent.move_type != 'out_invoice'"
        />
        <field
          name="upload_date"
          widget="date"
          optional="show"
          column_invisible="parent.move_type != 'out_invoice'"
        />
        <field
          name="deca_weight"
          optional="show"
          column_invisible="parent.move_type != 'out_invoice'"
        />
      </xpath>
    </field>
  </record>

  <record id="view_invoice_tree" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree" />
    <field name="arch" type="xml">
      <field name="invoice_date" position="before">
        <field
          name="carrier_contact_id"
          optional="show"
          readonly="1"
          string="Carrier"
        />
        <field
          name="tractor_license_plate_id"
          optional="show"
          readonly="1"
          string="Tractor"
        />
        <field
          name="trailer_license_plate_id"
          optional="show"
          readonly="1"
          string="Trailer"
        />
        <field name="special_authorization" optional="hide" readonly="1" />
        <field
          name="deca_weight"
          optional="show"
          readonly="1"
          sum="Total Deca Weight"
        />
      </field>
    </field>
  </record>

  <record id="view_account_invoice_filter" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="carrier_contact_id" string="Carrier" />
        <field
          name="invoice_line_ids"
          string="Place of loading"
          filter_domain="[('invoice_line_ids.place_of_loading_id', 'ilike', self)]"
        />
        <field
            name="invoice_line_ids"
            string="Place of delivery"
            filter_domain="[('invoice_line_ids.place_of_delivery_ids.name', 'ilike', self)]"
        />
        <field name="tractor_license_plate_id" string="Tractor" />
        <field name="trailer_license_plate_id" string="Trailer" />
      </field>
      <filter name="status" position="before">
        <filter
          name="carrier_contact"
          string="Carrier"
          domain="[]"
          context="{'group_by': 'carrier_contact_id'}"
        />
        <filter
          name="tractor_license_plate"
          string="Tractor"
          domain="[]"
          context="{'group_by': 'tractor_license_plate_id'}"
        />
        <filter
          name="trailer_license_plate"
          string="Trailer"
          domain="[]"
          context="{'group_by': 'trailer_license_plate_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
