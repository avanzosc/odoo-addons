<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_order_line_tree" model="ir.ui.view">
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_order_line_tree" />
    <field name="arch" type="xml">
      <field name="order_partner_id" position="after">
        <field
          name="carrier_contact_id"
          optional="show"
          readonly="1"
          string="Carrier"
        />
        <field
          name="tractor_license_plate_id"
          optional="show"
          readonly="1"
          string="Tractor"
        />
        <field
          name="trailer_license_plate_id"
          optional="show"
          readonly="1"
          string="Trailer"
        />
        <field name="special_authorization" optional="hide" readonly="1" />
        <field
          name="place_of_loading_id"
          optional="show"
          context="{'show_city': True}"
          readonly="1"
        />
        <field
          name="place_of_delivery_id"
          optional="show"
          context="{'show_city': True}"
          readonly="1"
        />
        <field
          name="deca_weight"
          optional="show"
          readonly="1"
          sum="Total Deca Weight"
        />
      </field>
    </field>
  </record>

  <record id="view_sales_order_line_filter" model="ir.ui.view">
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_sales_order_line_filter" />
    <field name="arch" type="xml">
      <field name="product_id" position="before">
        <field name="carrier_contact_id" string="Carrier" />
        <field name="place_of_loading_id" string="Place of loading" />
        <field name="place_of_delivery_id" string="Place of delivery" />
        <field name="tractor_license_plate_id" string="Tractor" />
        <field name="trailer_license_plate_id" string="Trailer" />
        <field name="special_authorization" />
        <field
          name="deca_weight"
          optional="show"
          readonly="1"
          sum="Total Deca Weight"
        />
      </field>
      <filter name="product" position="before">
        <filter
          string="Customer"
          name="order-partner"
          domain="[]"
          context="{'group_by':'order_partner_id'}"
        />
        <filter
          string="Place of loading"
          name="place_of_loading"
          domain="[]"
          context="{'group_by':'place_of_loading_id'}"
        />
        <filter
          string="Place of delivery"
          name="place_of_delivery"
          domain="[]"
          context="{'group_by':'place_of_delivery_id'}"
        />
        <filter
          string="Tractor"
          name="tractor"
          domain="[]"
          context="{'group_by':'tractor_license_plate_id'}"
        />
        <filter
          string="Trailer"
          name="trailerr"
          domain="[]"
          context="{'group_by':'trailer_license_plate_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
