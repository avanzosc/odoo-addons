<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <page name="customer_signature" position="before">
        <page string="DeCA" name="deca_info">
          <group>
            <group>
              <field name="tractor_license_plate_id" required="1" />
              <field name="trailer_license_plate_id" />
              <field name="carrier_contact_id" required="1" />
            </group>
            <group>
              <field name="special_authorization" widget="text" />
              <field name="deca_weight" />
            </group>
          </group>
          <separator string="DECA Notes" colspan="4" />
          <field name="deca_notes" colspan="4" nolabel="1" widget="text" />
        </page>
      </page>
      <xpath
        expr="//field[@name='order_line']/list/field[@name='product_uom_qty']"
        position="before"
      >
        <field
          name="place_of_loading_id"
          optional="show"
          context="{'show_city': True}"
        />
        <field
          name="place_of_delivery_id"
          optional="show"
          context="{'show_city': True}"
        />
        <field name="upload_date" widget="date" />
        <field name="deca_weight" />
      </xpath>
      <field name="partner_shipping_id" position="after">
        <field name="sale_import_id" />
      </field>
    </field>
  </record>

  <record id="sale_order_tree" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.sale_order_tree" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field
          name="carrier_contact_id"
          optional="show"
          readonly="1"
          string="Carrier"
        />
        <field
          name="tractor_license_plate_id"
          optional="show"
          readonly="1"
          string="Tractor"
        />
        <field
          name="trailer_license_plate_id"
          optional="show"
          readonly="1"
          string="Trailer"
        />
        <field name="special_authorization" optional="hide" readonly="1" />
        <field
          name="deca_weight"
          optional="show"
          readonly="1"
          sum="Total Deca Weight"
        />
      </field>
      <field name="date_order" position="before">
        <field name="sale_import_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="view_sales_order_filter" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter" />
    <field name="arch" type="xml">
      <filter name="my_sale_orders_filter" position="before">
        <field name="sale_import_id" />
      </filter>
      <field name="user_id" position="after">
        <field name="carrier_contact_id" string="Carrier" />
        <field
          name="order_line"
          string="Place of loading"
          filter_domain="[('order_line.place_of_loading_id', 'ilike', self)]"
        />
        <field
          name="order_line"
          string="Place of delivery"
          filter_domain="[('order_line.place_of_delivery_id', 'ilike', self)]"
        />
        <field name="tractor_license_plate_id" string="Tractor" />
        <field name="trailer_license_plate_id" string="Trailer" />
      </field>
      <filter name="my_sale_orders_filter" position="after">
        <filter
          string="From sales import"
          name="filter-from_sales_import"
          domain="[('sale_import_id', '!=', False)]"
        />
      </filter>
      <filter name="customer" position="after">
        <filter
          name="carrier_contact"
          string="Carrier"
          domain="[]"
          context="{'group_by': 'carrier_contact_id'}"
        />
        <filter
          name="tractor_license_plate"
          string="Main vehicle or tractor licence plate"
          domain="[]"
          context="{'group_by': 'tractor_license_plate_id'}"
        />
        <filter
          name="trailer_license_plate"
          string="Trailer or semi-trailer licence plate"
          domain="[]"
          context="{'group_by': 'trailer_license_plate_id'}"
        />
        <filter
          name="from-sale-import"
          string="From Sale Import"
          domain="[]"
          context="{'group_by': 'sale_import_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
