<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="page_catalogs" model="website.page">
    <field name="name">Catalogs</field>
    <field name="url">/catalogs</field>
    <field name="view_id" ref="website_sale_product_catalog.catalogs" />
    <field name="website_published">True</field>
  </record>

  <record id="menu_catalogs" model="website.menu">
    <field name="name">Catalogs</field>
    <field name="url">/catalogs</field>
    <field name="parent_id" ref="website.main_menu" />
    <field name="sequence">60</field>
    <field name="page_id" ref="page_catalogs" />
  </record>
</odoo>
