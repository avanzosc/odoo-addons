<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_line_detailed_tree_add_deadline" model="ir.ui.view">
    <field name="name">stock.move.line.detailed.tree.add.deadline</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='product_uom_id']" position="after">
        <field name="date_deadline" optional="show" />
      </xpath>
    </field>
  </record>

  <record id="view_move_line_operation_tree_add_deadline" model="ir.ui.view">
    <field name="name">stock.move.line.operation.tree.add.deadline</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='product_uom_id']" position="after">
        <field name="date_deadline" optional="show" />
      </xpath>
    </field>
  </record>
</odoo>
