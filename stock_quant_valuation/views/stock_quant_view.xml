<odoo>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="product_cost" optional="show"/>
                <field name="lot_average_unit_price" optional="show"/>
                <field name="lot_average_value" optional="show"/>
                <field name="lot_purchase_cost" optional="hide"/>
                <field name="lot_purchase_value" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>