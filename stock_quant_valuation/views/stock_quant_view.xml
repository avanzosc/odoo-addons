<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="inventory_date" position="before">
                <field name="product_cost" optional="show" />
                <field name="lot_purchase_cost" optional="show" />
                <field name="lot_purchase_value" optional="show" />
            </field>
        </field>
    </record>
</odoo>
