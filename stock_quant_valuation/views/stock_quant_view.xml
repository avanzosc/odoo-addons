<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="lot_cost" optional="show" />
                <field name="lot_value" optional="show" sum="Total" />
                <field name="product_cost" optional="show" />
                <field name="cost_value" optional="show" sum="Total Cost Value" />
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="lot_cost" optional="show" />
                <field name="lot_value" optional="show" sum="Total" />
                <field name="product_cost" optional="show" />
                <field name="cost_value" optional="show" sum="Total Cost Value" />
            </field>
        </field>
    </record>

    <record id="quant_search_view" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <filter name="priority_products" position="after">
                <filter
          string="Product/Lot Cost mismatch"
          name="cost_mismatch"
          domain="[('cost_mismatch','=',True)]"
        />
            </filter>
        </field>
    </record>
</odoo>
