#. module: stock_quant_valuation
#: model:ir.model.fields,help:stock_quant_valuation.field_stock_quant__lot_average_value
msgid ""
"Quant quantity multiplied by the lot average unit price (quant.quantity * "
"quant.lot_average_unit_price)."
msgstr ""
"Cantidad de existencias multiplicada por el precio unitario medio "
"del lote (quant.quantity * quant.lot_average_unit_price)."

#. module: stock_quant_valuation
#: model:ir.model.fields,help:stock_quant_valuation.field_stock_quant__lot_purchase_value
msgid ""
"Quant quantity multiplied by the lot purchase cost (quant.quantity * "
"quant.lot_purchase_cost)."
msgstr ""
"Cantidad de existencias multiplicada por el costo de compra del lote (quant.quantity * quant.lot_purchase_cost)."

