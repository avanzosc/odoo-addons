<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <th name="th_sm_product" position="after">
            <th name="th_sm_boxes-sacks">
                <strong>Packages</strong>
            </th>
        </th>
        <xpath expr="//span[@t-field='move.product_uom_qty']/.." position="before">
            <td name="td_boxes_sacks" class=" text-center">
                <span t-field="move.boxes_sacks" /><br />
                <span t-field="move.product_packaging_id" />
            </td>
        </xpath>
        <th name="th_sml_product" position="after">
            <th name="th_sml_boxes-sacks"><strong>Packages</strong></th>
        </th>
    </template>

    <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
  >
        <t name="move_line_lot" position="before">
            <td class="text-center" name="move_line_boxes_sacks">
                <span t-field="move_line.boxes_sacks" /><br />
                <span t-field="move.product_packaging_id" />
            </td>
        </t>
    </template>

    <template
    id="stock_report_delivery_aggregated_move_lines"
    inherit_id="stock.stock_report_delivery_aggregated_move_lines"
  >
        <xpath expr="//td[1]" position="after">
            <td class="text-center" name="move_line_aggregated_boxes_sacks">
                <t t-if="aggregated_lines[line]['boxes_sacks']">
                    <span t-esc="aggregated_lines[line]['boxes_sacks']" /><br />
                    <span t-esc="aggregated_lines[line]['product_packaging_id']" />
                </t>
            </td>
        </xpath>
    </template>
</odoo>
