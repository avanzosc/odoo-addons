<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="ir_cron_send_stock_mail" model="ir.cron">
    <field name="name">Contacts: Send Daily Stock</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="state">code</field>
    <field name="code">model._cron_send_stock_mail()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field
      name="nextcall"
      eval="pytz.timezone('Europe/Madrid').localize(DateTime.combine(DateTime.now().date() + timedelta(days=1), DateTime.min.time().replace(hour=13))).astimezone(pytz.utc).strftime('%Y-%m-%d %H:%M:%S')"
    />
    <field name="active" eval="False" />
  </record>
</odoo>
