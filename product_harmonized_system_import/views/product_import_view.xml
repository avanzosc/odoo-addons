<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_import_view_form" model="ir.ui.view">
    <field name="model">product.import</field>
    <field name="priority" eval="99" />
    <field name="inherit_id" ref="product_import_wizard.product_import_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_import_file']" position="replace">
        <button
          name="action_import_file"
          string="Import"
          type="object"
          invisible="state == 'done'"
        />
      </xpath>
      <xpath expr="//header/button[@name='action_validate']" position="replace">
        <button
          name="action_validate"
          string="Validate"
          type="object"
          invisible="state not in ('2validate', 'pass', 'error')"
        />
      </xpath>
      <xpath expr="//header/button[@name='action_process']" position="replace">
        <button
          name="action_process"
          string="Process"
          type="object"
          invisible="state not in ('pass', 'error')"
        />
      </xpath>
      <xpath expr="//div[@name='help']/ul" position="inside">
        <li><code>HS Code</code>: this will fill <b>HS Code.</b></li>
        <li><code>Origin Country</code>: this will fill <b>Origin Country. </b></li>
      </xpath>
    </field>
  </record>
</odoo>
