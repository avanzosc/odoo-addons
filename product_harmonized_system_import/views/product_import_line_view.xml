<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_import_line_view_form" model="ir.ui.view">
    <field name="model">product.import.line</field>
    <field name="priority" eval="99" />
    <field
      name="inherit_id"
      ref="product_import_wizard.product_import_line_view_form"
    />
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='button_validate']" position="replace">
        <button
          name="button_validate"
          string="Validate"
          type="object"
          invisible="state not in ('2validate', 'error')"
        />
      </xpath>
      <xpath expr="//header/button[@name='button_process']" position="replace">
        <button
          name="button_process"
          string="Process"
          type="object"
          invisible="state != 'pass'"
        />
      </xpath>
      <field name="product_type" position="after">
        <field name="hs_code" />
        <field name="hs_code_id" options="{'no_create': True, 'no_open': True}" />
        <field name="origin_country" />
        <field
          name="origin_country_id"
          options="{'no_create': True, 'no_open': True}"
        />
      </field>
    </field>
  </record>

  <record id="product_import_line_view_tree" model="ir.ui.view">
    <field name="model">product.import.line</field>
    <field
      name="inherit_id"
      ref="product_import_wizard.product_import_line_view_tree"
    />
    <field name="arch" type="xml">
      <field name="product_type" position="after">
        <field name="hs_code" optional="show" />
        <field name="hs_code_id" optional="hide" />
        <field name="origin_country" optional="show" />
        <field name="origin_country_id" optional="hide" />
      </field>
    </field>
  </record>
</odoo>
