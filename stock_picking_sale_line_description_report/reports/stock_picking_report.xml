<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_delivery_document" inherit_id="stock.report_delivery_document">
        <span t-field="move.product_id" position="before">
            <span t-if="move.sale_line_id" t-field="move.sale_line_id.name" />
        </span>
        <span t-field="move.product_id" position="attributes">
            <attribute name="t-if">not move.sale_line_id</attribute>
        </span>
        <xpath
      expr="//span[@t-field='move.description_picking']/.."
      position="attributes"
    >
            <attribute
        name="t-if"
      >not move.sale_line_id and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name</attribute>
        </xpath>
        <span t-field="bo_line.product_id" position="before">
            <span t-if="bo_line.sale_line_id" t-field="bo_line.sale_line_id.name" />
        </span>
        <span t-field="bo_line.product_id" position="attributes">
            <attribute name="t-if">not bo_line.sale_line_id</attribute>
        </span>
        <xpath
      expr="//span[@t-field='bo_line.description_picking']/.."
      position="attributes"
    >
            <attribute
        name="t-if"
      >not bo_line.sale_line_id and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name</attribute>
        </xpath>
    </template>

    <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
  >
        <span t-field="move_line.product_id" position="before">
            <span
        t-if="move_line.move_id.sale_line_id"
        t-field="move_line.move_id.sale_line_id.name"
      />
        </span>
        <span t-field="move_line.product_id" position="attributes">
            <attribute name="t-if">not move_line.move_id.sale_line_id</attribute>
        </span>
        <span t-esc="description" position="attributes">
            <attribute name="t-if">not move_line.move_id.sale_line_id</attribute>
        </span>
    </template>

    <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
  >
        <span t-field="move_line.product_id" position="before">
            <span
        t-if="move_line.move_id.sale_line_id"
        t-field="move_line.move_id.sale_line_id.name"
      />
        </span>
        <span t-field="move_line.product_id" position="attributes">
            <attribute name="t-if">not move_line.move_id.sale_line_id</attribute>
        </span>
        <span t-esc="description" position="attributes">
            <attribute name="t-if">not move_line.move_id.sale_line_id</attribute>
        </span>
    </template>
</odoo>
