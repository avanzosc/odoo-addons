<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_shape_view_list" model="ir.ui.view">
    <field name="name">product.shape.list</field>
    <field name="model">product.shape</field>
    <field name="arch" type="xml">
      <list>
        <field name="brand_info" />
        <field name="name" />
        <field name="attribute_value_count" />
        <field name="mould_id" />
        <field name="template_id" optional="hide" />
        <field name="similar_shape_id" optional="hide" />
        <field name="length_mm" />
        <field name="width_mm" />
        <field name="nose_mm" optional="hide" />
        <field name="tail_mm" optional="hide" />
        <field name="wheelbase_mm" optional="hide" />
        <field name="length_in" optional="hide" />
        <field name="width_in" optional="hide" />
        <field name="nose_in" optional="hide" />
        <field name="tail_in" optional="hide" />
        <field name="wheelbase_in" optional="hide" />
        <field name="sale_length" optional="hide" />
        <field name="sale_width" optional="hide" />
        <field name="symmetric" optional="hide" />
        <field name="company_id" optional="hide" />
      </list>
    </field>
  </record>

  <record id="product_shape_view_form" model="ir.ui.view">
    <field name="name">product.shape.form</field>
    <field name="model">product.shape</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name" />
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="brand_info" />
              <field name="similar_shape_id" />
              <field name="customer_table_ref" />
            </group>
            <group>
              <field name="mould_id" readonly="1" />
              <field name="attribute_value_count" />
              <field name="template_id" />
              <field name="company_id" />
            </group>
          </group>
          <group string="Measurements" col="4">
            <field name="length_mm" />
            <field name="length_in" />
            <field name="width_mm" />
            <field name="width_in" />
            <field name="wheelbase_mm" />
            <field name="wheelbase_in" />
            <field name="nose_mm" />
            <field name="nose_in" />
            <field name="tail_mm" />
            <field name="tail_in" />
          </group>
          <group string="Sale Measurements">
            <field name="sale_length" />
            <field name="sale_width" />
          </group>
          <group string="Features">
            <field name="wheel_well_recesses" />
            <field name="double_wheelbase" />
            <field name="symmetric" readonly="1" />
            <field name="drop" />
            <field name="exclusive" />
          </group>
          <group string="Comments">
            <field name="comments" nolabel="1" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_shape_view_search" model="ir.ui.view">
    <field name="name">product.shape.search</field>
    <field name="model">product.shape</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="brand_info" />
        <field name="mould_id" />
        <field name="template_id" />
        <filter
          name="without_attribute_values"
          string="Without Attribute Values"
          domain="[('attribute_value_count', '=', 0)]"
        />
        <filter
          name="one_attribute_value"
          string="One Attribute Value"
          domain="[('attribute_value_count', '=', 1)]"
        />
        <filter
          name="duplicated_attribute_values"
          string="Duplicated Attribute Values"
          domain="[('attribute_value_count', '&gt;', 1)]"
        />
        <group expand="0" string="Group By">
          <filter
            name="group_by_brand_info"
            string="Brand Info"
            context="{'group_by': 'brand_info'}"
          />
          <filter
            name="group_by_mould"
            string="Mould"
            context="{'group_by': 'mould_id'}"
          />
          <filter
            name="group_by_company"
            string="Company"
            context="{'group_by': 'company_id'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="product_shape_action" model="ir.actions.act_window">
    <field name="name">Shapes</field>
    <field name="res_model">product.shape</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="product_shape_view_search" />
  </record>

  <menuitem
    id="product_shape_menu"
    name="Shapes"
    action="product_shape_action"
    parent="product_mould_template_menu"
    sequence="30"
  />
</odoo>
