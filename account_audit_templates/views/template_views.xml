<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="account_chart_template_audit_tree_view" model="ir.ui.view">
        <field name="name">account.chart.template.audit.tree</field>
        <field name="model">account.chart.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code_digits" />
                <field name="currency_id" />
                <field name="parent_id" />
                <field name="visible" />
            </tree>
        </field>
    </record>

    <record id="account_chart_template_audit_form_view" model="ir.ui.view">
        <field name="name">account.chart.template.audit.form</field>
        <field name="model">account.chart.template</field>
        <field name="arch" type="xml">
            <form string="Plan Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="parent_id" />
                            <field name="currency_id" />
                            <field name="code_digits" />
                        </group>
                        <group>
                            <field name="visible" />
                            <field name="use_anglo_saxon" />
                            <field name="complete_tax_set" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_chart_template_audit" model="ir.actions.act_window">
        <field name="name">Configuration of Plans</field>
        <field name="res_model">account.chart.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="account_chart_template_audit_tree_view" />
    </record>

    <record id="account_account_template_audit_tree_view" model="ir.ui.view">
