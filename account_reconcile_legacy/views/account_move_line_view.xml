<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_line_reconcile_legacy" model="ir.ui.view">
    <field name="name">
      account.move.line.list.reconcile.legacy
    </field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account_accountant.view_move_line_reconcile_tree" />
    <field name="mode">primary</field>

    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="js_class">legacy_account_move_line_reconcile_list</attribute>
      </xpath>

      <xpath expr="//field[@name='analytic_distribution']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='amount_currency']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='currency_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='matching_number']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='amount_residual']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='amount_residual_currency']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <xpath expr="//field[@name='partner_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='move_name']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='ref']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
      <xpath expr="//field[@name='invoice_date']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='company_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='journal_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='account_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='product_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='tax_ids']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='tax_tag_ids']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='discount_date']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='discount_amount_currency']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='tax_line_id']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='date_maturity']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>

      <xpath expr="//field[@name='balance']" position="attributes">
        <attribute name="column_invisible">True</attribute>
      </xpath>
    </field>
  </record>

  <record id="action_manual_account_reconcile_legacy" model="ir.actions.act_window">
    <field name="name">Conciliación manual clásica</field>
    <field name="res_model">account.move.line</field>
    <field name="path">legacy-reconcile</field>
    <field name="view_mode">list</field>
    <field
      name="search_view_id"
      ref="account_accountant.view_account_move_line_reconcile_search"
    />
    <field name="view_id" ref="view_move_line_reconcile_legacy" />
    <field name="domain">
      [
        ("display_type", "not in", ("line_section", "line_note")),
        ("account_id.reconcile", "=", True),
        ("parent_state", "=", "posted"),
        ("full_reconcile_id", "=", False)
      ]
    </field>
    <field name="context">
      {
        "journal_type": "general",
        "search_default_unreconciled": True,
        "search_default_group_by_account": True
      }
    </field>
  </record>

  <menuitem
    id="menu_manual_account_reconcile_legacy_view"
    name="Conciliación manual clásica"
    parent="account.menu_finance_entries"
    action="action_manual_account_reconcile_legacy"
    sequence="142"
    groups="account.group_account_user"
  />
</odoo>
