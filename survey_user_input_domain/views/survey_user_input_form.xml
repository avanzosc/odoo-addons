<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="survey_user_input_line_view_form" model="ir.ui.view">
            <field name="name">survey.user_input.line.view.form</field>
            <field name="model">survey.user_input.line</field>
            <field name="inherit_id" ref="survey.survey_user_input_line_view_form" />
            <field name="arch" type="xml">
                <field name="suggested_answer_id" position="before">
                    <field
          name="calculated_suggested_answer_question_ids"
          attrs="{'invisible': True}"
        />
                </field>
                <field name="matrix_row_id" position="before">
                    <field
          name="calculated_matrix_question_ids"
          attrs="{'invisible': True}"
        />
                </field>

                <field name="suggested_answer_id" position="attributes">
                    <attribute
          name="domain"
        >[('id', '=', calculated_suggested_answer_question_ids)]</attribute>
                </field>
                <field name="matrix_row_id" position="attributes">
                    <attribute
          name="domain"
        >[('id', '=', calculated_matrix_question_ids)]</attribute>
                </field>
            </field>
        </record>
</odoo>
