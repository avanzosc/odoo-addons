<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='result_package_id'][@groups='stock.group_tracking_lot']"
        position="attributes"
      >
        <attribute name="domain">[('picking_id','=',picking_id)]</attribute>
      </xpath>
      <xpath
        expr="//field[@name='result_package_id'][@groups='stock.group_tracking_lot']"
        position="after"
      >
        <field name="line_weight" optional="show" />
        <field name="manual_pack_weight" optional="show" />
        <field name="shipping_weight" optional="show" />
        <field name="weight_uom_name" string="Weight UoM" optional="hide" />
      </xpath>
    </field>
  </record>

  <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='result_package_id'][@groups='stock.group_tracking_lot']"
        position="attributes"
      >
        <attribute name="domain">[('picking_id','=',picking_id)]</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_move_line_form" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='result_package_id'][@groups='stock.group_tracking_lot']"
        position="attributes"
      >
        <attribute name="domain">[('picking_id','=',picking_id)]</attribute>
      </xpath>
    </field>
  </record>

  <record id="view_move_line_tree" model="ir.ui.view">
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_tree" />
    <field name="arch" type="xml">
      <field name="location_id" position="before">
        <field name="line_weight" optional="show" />
        <field name="manual_pack_weight" optional="show" />
        <field name="shipping_weight" optional="show" />
        <field name="weight_uom_name" string="Weight UoM" optional="hide" />
      </field>
    </field>
  </record>
</odoo>
