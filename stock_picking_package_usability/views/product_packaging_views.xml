<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_packaging_delivery_tree" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="delivery.product_packaging_delivery_tree" />
        <field name="arch" type="xml">
            <field name="height" position="after">
                <field name="length_uom_id" string=" " />
            </field>
            <field name="width" position="after">
                <field name="length_uom_id" string=" " />
            </field>
            <field name="packaging_length" position="after">
                <field name="length_uom_id" string=" " />
            </field>
            <field name="max_weight" position="after">
                <field name="weight_uom_id" string=" " />
            </field>
        </field>
    </record>
    <record id="view_delivery_product_packaging_form_inherit" model="ir.ui.view">
            <field name="name">delivery.product_packaging_delivery_form.inherit</field>
            <field name="model">product.packaging</field>
            <field name="inherit_id" ref="delivery.product_packaging_delivery_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='max_weight']" position="after">
                    <label string="Peso vacío" for="empty_weight" />
                    <div class="o_row" name="empty_weight">
                        <field name="empty_weight" />
                        <span><field name="weight_uom_name" /></span>
                    </div>
                </xpath>
            </field>
    </record>
</odoo>
