<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_packaging_tree_view" model="ir.ui.view">
    <field name="model">product.packaging</field>
    <field name="inherit_id" ref="product.product_packaging_tree_view" />
    <field name="arch" type="xml">
      <field name="product_uom_id" position="after">
        <field name="height" />
        <field name="width" />
        <field name="packaging_length" />
        <field name="length_uom_id" string=" " />
        <field name="weight" />
        <field name="max_weight" />
        <field name="weight_uom_id" string=" " />
      </field>
    </field>
  </record>

  <record id="product_packaging_form_view" model="ir.ui.view">
    <field name="name">product.packaging.form.view.usability</field>
    <field name="model">product.packaging</field>
    <field name="inherit_id" ref="product.product_packaging_form_view" />
    <field name="arch" type="xml">
      <group id="group_weight" position="after">
        <group id="group_max_weight">
          <label for="max_weight" />
          <div class="o_row" name="max_weight">
            <field name="max_weight" />
            <span>
              <field name="weight_uom_name" />
            </span>
          </div>
        </group>
      </group>
    </field>
  </record>
</odoo>
