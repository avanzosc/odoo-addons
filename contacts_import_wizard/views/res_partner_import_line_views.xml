<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_partner_import_line_view_search" model="ir.ui.view">
    <field name="model">res.partner.import.line</field>
    <field name="arch" type="xml">
      <search>
        <field name="partner_name" />
        <separator />
        <filter string="Errored" name="error" domain="[('state', '=', 'error')]" />
        <separator />
        <filter
          string="To Update"
          name="2update"
          domain="[('action', '=', 'update')]"
        />
        <filter
          string="To Create"
          name="2create"
          domain="[('action', '=', 'create')]"
        />
        <filter
          string="Do Nothing"
          name="do_nothing"
          domain="[('action', '=', 'nothing')]"
        />
        <group expand="0" name="group_by" string="Group By">
          <filter
            name="group_parent"
            string="Related Company"
            context="{'group_by': 'partner_parent_id'}"
          />
          <filter
            name="group_type"
            string="Contact Type"
            context="{'group_by': 'partner_type'}"
          />
          <filter
            name="group_country"
            string="Partner Country"
            context="{'group_by': 'partner_country_id'}"
          />
          <filter
            name="group_state"
            string="Partner State"
            context="{'group_by': 'partner_state_id'}"
          />
          <filter
            name="group_city"
            string="Partner City"
            context="{'group_by': 'partner_city_id'}"
          />
          <separator />
          <filter name="group_status" string="Status" context="{'group_by': 'state'}" />
          <filter string="Action" name="group_action" context="{'group_by':'action'}" />
          <filter
            name="group_wizard"
            string="Import Wizard"
            context="{'group_by': 'import_id'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="res_partner_import_line_view_form" model="ir.ui.view">
    <field name="model">res.partner.import.line</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="button_validate"
            string="Validate"
            type="object"
            invisible="state in ('draft','done')"
          />
          <button
            name="button_process"
            string="Process"
            type="object"
            invisible="state != 'pass'"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="partner_ref" readonly="state == 'done'" />
              <field name="partner_name" readonly="state == 'done'" />
              <field name="partner_parent_name" readonly="state == 'done'" />
              <field name="partner_company_type" readonly="state == 'done'" />
              <field name="partner_vat" readonly="state == 'done'" />
              <field name="partner_type" readonly="state == 'done'" />
              <field name="partner_street" readonly="state == 'done'" />
              <field name="partner_street2" readonly="state == 'done'" />
              <field name="partner_zip" readonly="state == 'done'" />
              <field name="partner_city" readonly="state == 'done'" />
              <field name="partner_state" readonly="state == 'done'" />
              <field name="partner_country" readonly="state == 'done'" />
              <field name="partner_phone" readonly="state == 'done'" />
              <field name="partner_mobile" readonly="state == 'done'" />
              <field name="partner_email" readonly="state == 'done'" />
              <field name="partner_website" readonly="state == 'done'" />
              <field name="partner_function" readonly="state == 'done'" />
            </group>
            <group>
              <field name="action" />
              <field
                name="partner_id"
                readonly="state == 'done'"
                options="{'no_create': True}"
              />
              <field
                name="partner_parent_id"
                readonly="state == 'done'"
                options="{'no_create': True}"
              />
              <field
                name="partner_zip_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
              <field
                name="partner_city_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
              <field
                name="partner_country_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
              <field
                name="partner_state_id"
                readonly="state == 'done'"
                options="{'no_create': True, 'no_open': True}"
              />
            </group>
          </group>
          <field name="log_info" />
        </sheet>
      </form>
    </field>
  </record>

  <record id="res_partner_import_line_base_view_tree" model="ir.ui.view">
    <field name="model">res.partner.import.line</field>
    <field name="arch" type="xml">
      <list
        decoration-danger="state == 'error'"
        decoration-muted="state == 'done'"
        decoration-it="log_info"
        editable="top"
      >
        <field
          name="import_id"
          column_invisible="context.get('default_import_id', True)"
        />
        <field
          name="action"
          decoration-muted="action == 'nothing'"
          decoration-success="action == 'create'"
          decoration-info="action == 'update'"
          readonly="state == 'done'"
        />
        <field name="partner_ref" readonly="state == 'done'" />
        <field name="partner_name" readonly="state == 'done'" />
        <field name="partner_comercial" readonly="state == 'done'" optional="hide" />
        <field name="partner_company_type" readonly="state == 'done'" />
        <field name="partner_vat" readonly="state == 'done'" />
        <field name="partner_id" readonly="state == 'done'" optional="hide" />
        <field name="partner_type" readonly="state == 'done'" />
        <field
          name="partner_parent_name"
          readonly="state == 'done'"
          string="Related Company"
        />
        <field
          name="partner_parent_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True}"
        />
        <field name="partner_function" readonly="state == 'done'" />
        <field name="partner_street" readonly="state == 'done'" />
        <field name="partner_street2" readonly="state == 'done'" optional="hide" />
        <field name="partner_zip" readonly="state == 'done'" />
        <field
          name="partner_zip_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="partner_city" readonly="state == 'done'" string="City" />
        <field
          name="partner_city_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="partner_state" readonly="state == 'done'" string="State" />
        <field
          name="partner_state_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="partner_country" readonly="state == 'done'" string="Country" />
        <field
          name="partner_country_id"
          readonly="state == 'done'"
          optional="hide"
          options="{'no_create': True, 'no_open': True}"
        />
        <field name="partner_phone" readonly="state == 'done'" />
        <field name="partner_mobile" readonly="state == 'done'" />
        <field name="partner_email" readonly="state == 'done'" />
        <field name="partner_website" readonly="state == 'done'" />
        <field name="partner_comment" readonly="state == 'done'" />
        <field name="state" optional="hide" />
        <field name="log_info" optional="hide" />
        <button
          name="action_open_form"
          type="object"
          title="Open form view"
          icon="fa-external-link"
        />
        <button
          name="button_validate"
          type="object"
          title="Validate"
          icon="fa-search"
          invisible="state in ('draft','done')"
        />
        <button
          name="button_process"
          type="object"
          title="Process"
          icon="fa-check"
          invisible="state != 'pass'"
        />
      </list>
    </field>
  </record>

  <record id="res_partner_import_line_view_tree" model="ir.ui.view">
    <field name="model">res.partner.import.line</field>
    <field name="inherit_id" ref="res_partner_import_line_base_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <field name="import_id" position="attributes">
        <attribute name="column_invisible" />
        <attribute name="optional">hide</attribute>
      </field>
    </field>
  </record>

  <record id="res_partner_import_line_action" model="ir.actions.act_window">
    <field name="name">Import Contact Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.partner.import.line</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="res_partner_import_line_view_tree" />
  </record>

  <record id="res_partner_import_line_form_action" model="ir.actions.act_window">
    <field name="name">Import Contact Lines</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.partner.import.line</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="res_partner_import_line_view_form" />
  </record>

  <record id="action_button_validate" model="ir.actions.server">
    <field name="name">Validate</field>
    <field name="model_id" ref="contacts_import_wizard.model_res_partner_import_line" />
    <field
      name="binding_model_id"
      ref="contacts_import_wizard.model_res_partner_import_line"
    />
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">
            if records:
                records.button_validate()
        </field>
  </record>

  <record id="action_button_process" model="ir.actions.server">
    <field name="name">Process</field>
    <field name="model_id" ref="contacts_import_wizard.model_res_partner_import_line" />
    <field
      name="binding_model_id"
      ref="contacts_import_wizard.model_res_partner_import_line"
    />
    <field name="type">ir.actions.server</field>
    <field name="state">code</field>
    <field name="code">
            if records:
                records.button_process()
        </field>
  </record>
</odoo>
