<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="stock_package_type_tree" model="ir.ui.view">
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_tree" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="product_tmpl_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="stock_package_type_form" model="ir.ui.view">
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <label for="length_uom_name" position="before">
                <field name="product_tmpl_id" />
            </label>
        </field>
    </record>

    <record id="stock_package_type_search_view" model="ir.ui.view">
        <field name="name">stock.package.type.search.view</field>
        <field name="model">stock.package.type</field>
        <field name="arch" type="xml">
            <search string="Search Package Types">
                <field name="name" />
                <field name="product_tmpl_id" />
                <group expand="0" string="Group By">
                    <filter
            string="Product"
            name="product"
            domain="[]"
            context="{'group_by': 'product_tmpl_id'}"
          />
                </group>
            </search>
        </field>
    </record>
</odoo>
