<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <page name="inventory" position="after">
                <page name="package-types" string="Package types">
                    <field name="package_type_ids" nolabel="1" />
                </page>
            </page>
            <button name="action_open_label_layout" position="after">
                <button
          string="Generate Packaging In Products"
          type="object"
          name="action_create_product_packages"
          attrs="{'invisible': [('package_type_ids', '==', False)]}"
        />
            </button>
        </field>
    </record>

    <record id="product_template_form_view2" model="ir.ui.view">
        <field name="model">product.template</field>
        <field
      name="inherit_id"
      ref="product_logistics_uom.product_template_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='volume_uom_id']/.." position="after">
                <label for="product_density" />
                <field
          name="product_density"
          string="Density"
          class="oe_inline"
          nolabel="1"
        />
            </xpath>
        </field>
    </record>
</odoo>
