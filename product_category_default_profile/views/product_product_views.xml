<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_product_tree_view" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="top_transfer_product_id" optional="show" />
        <field name="bottom_transfer_product_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="product_product_normal_form_view" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="top_transfer_product_id" invisible="not requires_transfer" />
        <field name="bottom_transfer_product_id" invisible="not requires_transfer" />
      </field>
    </field>
  </record>
</odoo>
