<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_cleaning_database" model="ir.cron">
        <field name="name">Cleaning Database</field>
        <field
      name="model_id"
      ref="cleaning_database_operations.model_cleaning_database"
    />
        <field name="state">code</field>
        <field name="code">model.cron_action_full_delete(automatic=True)</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="priority">100</field>
    </record>

</odoo>
