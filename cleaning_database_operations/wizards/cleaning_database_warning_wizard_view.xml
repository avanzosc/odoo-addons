<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cleaning_database_warning_wizard_view_form" model="ir.ui.view">
        <field name="name">cleaning.database.warning.wizard.form</field>
        <field name="model">cleaning.database.warning.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="text" readonly="1" force_save="1" nolabel="1" />
                    <field name="object_to_delete" invisible="1" />
                    <footer>
                        <button
              name="continue_with_cleaning_database"
              string="Continue"
              type="object"
              class="oe_link"
            />
                        or
                        <button special="cancel" string="Cancel" class="oe_highlight" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
