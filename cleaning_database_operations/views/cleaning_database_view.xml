    <record model="ir.ui.view" id="cleaning_database_search_view">
        <field name="name">cleaning.database.search</field>
        <field name="model">cleaning.database</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_ids" />
                <field name="state" />
                <filter
          name="draft"
          string="Draft"
          domain="[('state', '=', 'draft')]"
        />
                <filter
          name="scheduled"
          string="Scheduled"
          domain="[('state', '=', 'scheduled')]"
        />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <group expand="0" string="Group By">
                    <filter
            name="group_state"
            string="State"
            context="{'group_by': 'state'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="cleaning_database_tre_view">
        <field name="name">cleaning.database.tree.view</field>
        <field name="model">cleaning.database</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-muted="state == 'done'">
                <field name="name" />
                <field name="company_ids" widget="many2many_tags" />
                <field name="date_limit" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="action_cleaning_database_view" model="ir.actions.act_window">
        <field name="name">Cleaning Database</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cleaning.database</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
    name="Cleaning Database"
    id="cleaning_database"
    sequence="100"
    web_icon="cleaning_database_operations,static/description/icon.png"
  />

    <menuitem
    action="action_cleaning_database_view"
    id="menu_view_cleaning_database"
    parent="cleaning_database"
    sequence="1"
  />

</odoo>
