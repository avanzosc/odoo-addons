<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.cleaning</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='user_default_rights']" position="after">
                <h2>Cleaning Database</h2>
                <div class="row mt16 o_settings_container" name="cleaning_database">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="cleaning_base_batch_size" />
                            <div class="text-muted">
                                Set a default batch size for database cleaning operations
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <span>Default Batch Size: <field
                      name="cleaning_base_batch_size"
                      class="oe_inline"
                    /></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
