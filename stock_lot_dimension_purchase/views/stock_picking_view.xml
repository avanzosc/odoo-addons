<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='move_ids_without_package']/list/field[@name='product_uom_qty']"
        position="before"
      >
        <field name="purchase_line_id" column_invisible="True" />
        <field
          name="purchase_length"
          string="Length"
          optional="show"
          column_invisible="parent.picking_type_code != 'incoming'"
          invisible="not purchase_line_id"
        />
        <field
          name="purchase_length_uom_id"
          string="Length UoM"
          optional="show"
          options="{'no_open': True}"
          column_invisible="parent.picking_type_code != 'incoming'"
          invisible="not purchase_line_id"
        />
      </xpath>
    </field>
  </record>
</odoo>
