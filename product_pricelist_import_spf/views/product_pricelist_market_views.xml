<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_pricelist_market_view_tree" model="ir.ui.view">
    <field name="name">product.pricelist.market.list</field>
    <field name="model">product.pricelist.market</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="product_pricelist_market_view_form" model="ir.ui.view">
    <field name="name">product.pricelist.market.form</field>
    <field name="model">product.pricelist.market</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_pricelist_market_action" model="ir.actions.act_window">
    <field name="name">Pricelist Markets</field>
    <field name="res_model">product.pricelist.market</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="product_pricelist_market_menu"
    name="Pricelist Markets"
    parent="sale.product_menu_catalog"
    action="product_pricelist_market_action"
    sequence="21"
  />
</odoo>
