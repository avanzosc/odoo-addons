<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
    id="view_stock_move_line_detailed_operation_tree_inherit_reader_ps"
    model="ir.ui.view"
  >
        <field name="model">stock.move.line</field>
        <field
      name="inherit_id"
      ref="stock.view_stock_move_line_detailed_operation_tree"
    />
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="picking_type_code" invisible="1" />
                <field
          name="reader_ps"
          context="{'from_stock_picking': True}"
          optional="show"
          attrs="{
                      'invisible': [('picking_type_code','not in',('incoming','outgoing'))]
                    }"
        />
            </field>
        </field>
    </record>
    <record
    id="view_stock_move_line_operation_tree_inherit_reader_ps"
    model="ir.ui.view"
  >
        <field name="name">stock.move.line.operation.tree.inherit.reader</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
           <xpath expr="//field[@name='location_dest_id']" position="before">
               <field name="picking_type_code" invisible="1" />
               <field
          name="reader_ps"
          context="{'from_stock_picking': True}"
          attrs="{
                        'invisible': [('picking_type_code','not in',('incoming','outgoing'))]
                      }"
        />
            </xpath>
        </field>
    </record>
    <record id="view_stock_move_line_tree_inherit_reader_ps" model="ir.ui.view">
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="picking_type_code" invisible="1" />
                <field
          name="reader_ps"
          context="{'from_stock_picking': True}"
          optional="show"
          attrs="{
                      'invisible': [('picking_type_code','not in',('incoming','outgoing'))]
                    }"
        />
            </field>
        </field>
    </record>
</odoo>
