<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.ui.view" id="product_supplierinfo_form_view">
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="product.product_supplierinfo_form_view" />
    <field name="arch" type="xml">
      <field name="company_id" position="before">
        <label for="purchase_weight" />
        <div class="o_row">
          <field name="purchase_weight" />
          <field
            name="purchase_weight_uom_id"
            groups="uom.group_uom"
            options="{'no_open': True}"
          />
        </div>
        <label for="purchase_length" />
        <div class="o_row">
          <field name="purchase_length" />
          <field
            name="purchase_length_uom_id"
            groups="uom.group_uom"
            options="{'no_open': True}"
          />
        </div>
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="product_supplierinfo_tree_view2">
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2" />
    <field name="arch" type="xml">
      <field name="delay" position="before">
        <field name="purchase_weight" />
        <field name="purchase_weight_uom_id" groups="uom.group_uom" />
        <field name="purchase_length" />
        <field name="purchase_length_uom_id" groups="uom.group_uom" />
      </field>
    </field>
  </record>
</odoo>
