<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_stock_quant_tree_editable" model="ir.ui.view">
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
    <field name="arch" type="xml">
      <field name="product_uom_id" position="after">
        <field name="pricing_method" optional="hide" />
        <field name="product_length" optional="show" />
        <field name="product_height" optional="show" />
        <field name="product_width" optional="show" />
        <field
          name="product_dimensional_uom_id"
          string="Dim. UoM"
          optional="show"
          options="{'no_open': True}"
        />
        <field name="product_volume" optional="show" />
        <field name="product_volume_uom_name" string="Vol. UoM" optional="show" />
        <field name="product_weight" optional="show" />
        <field name="product_weight_uom_name" string="Weight UoM" optional="show" />
      </field>
    </field>
  </record>
</odoo>
