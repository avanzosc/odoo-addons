<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="wiz_duplicate_product_location_exploded_form_view" model="ir.ui.view">
        <field name="model">wiz.duplicate.product.location.exploded</field>
        <field name="arch" type="xml">
            <form string="Duplicate Products Exploded Locations">
                <p class="oe_grey">
                    <string
          >You are going to duplicate selected products exploded locations, with the new information you enter. Are you sure? </string>
                </p>
                <group>
                    <field name="product_final_id" colspan="4" />
                    <field name="view_version_id" colspan="4" />
                    <field name="product_list_version_id" colspan="4" />
                </group>
                <footer>
                    <button
            string="Duplicate"
            name="button_duplicate_product_location_exploded"
            type="object"
            default_focus="1"
            class="btn-primary"
          />
                 <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record
    id="action_wiz_generate_alternative_sale_code"
    model="ir.actions.act_window"
  >
        <field name="name">Duplicate Wizard</field>
        <field name="res_model">wiz.duplicate.product.location.exploded</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_product_location_exploded" />
        <field name="view_id" ref="wiz_duplicate_product_location_exploded_form_view" />
    </record>
</odoo>
