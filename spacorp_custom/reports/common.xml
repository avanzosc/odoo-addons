    <template id="external_layout_sale">
        <t t-if="not o" t-set="o" t-value="doc" />
        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id" />
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()" />
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company" />
            </t>
        </t>
        <t t-call="spacorp_custom.external_layout_sale_standard"><t t-raw="0" /></t>
    </template>

    <template id="external_layout_invoice">
        <t t-if="not o" t-set="o" t-value="doc" />
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id" />
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()" />
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company" />
            </t>
        </t>
        <t t-call="spacorp_custom.external_layout_invoice_standard"><t t-raw="0" /></t>
    </template>

    <record id="base.paperformat_euro" model="report.paperformat">
        <field name="name">European A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top" eval="45" />
        <field name="margin_bottom" eval="15" />
        <field name="margin_left" eval="7" />
        <field name="margin_right" eval="7" />
        <field name="header_line" eval="False" />
        <field name="header_spacing" eval="45" />
        <field name="dpi" eval="90" />
    </record>
</odoo>
