<?xml version="1.0" ?>
<odoo>
    <record id="view_move_form_inh_spacorp" model="ir.ui.view">
        <field name="name">view.move.form.inh.spacorp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='line_ids']/tree/field[@name='analytic_distribution']"
        position="before"
      >
                <field name="team_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inh_spacorp2" model="ir.ui.view">
        <field name="name">view.move.form.inh.spacorp2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_tax_balance.view_move_form" />
        <field name="arch" type="xml">
            <field name="move_type" position="after">
                <field name="team_id" readonly="1" />
            </field>
        </field>
    </record>

    <record id="view_move_tree_inh_spacorp" model="ir.ui.view">
        <field name="name">view.move.tree.inh.spacorp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_tax_balance.view_move_tree" />
        <field name="arch" type="xml">
            <field name="financial_type" position="after">
                <field name="team_id" readonly="1" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_account_move_filter_inh_spacorp" model="ir.ui.view">
        <field name="name">view.account.move.filter.inh.spacorp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_tax_balance.view_account_move_filter" />
        <field name="arch" type="xml">
            <filter name="financial_type" position="after">
                <filter
          name="group_by_division"
          string="Division"
          domain="[]"
          context="{'group_by':'team_id'}"
        />
            </filter>
        </field>
    </record>

    <record id="view_account_move_filter_inh_spacorp2" model="ir.ui.view">
        <field name="name">view.account.move.filter.inh.spacorp2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="team_id" />
            </field>
        </field>
    </record>
</odoo>
