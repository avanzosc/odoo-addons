<?xml version="1.0" ?>
<odoo>
    <record id="invoice_form_inh_spacorp" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <field name="invoice_cash_rounding_id" position="before">
                <field
          name="market_id"
          string="Sale channel"
          readonly="1"
          invisible="1"
        />
                <field
          name="market_sector_id"
          string="Market niche"
          readonly="1"
          invisible="1"
        />

            </field>
            <field name="fiscal_position_id" position="attributes">
                <attribute name="context">{'division': team_id}</attribute>
            </field>
        </field>
    </record>

    <record id="invoice_tree_inh_spacorp" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="before">
                <field name="market_id" string="Sale channel" optional="hide" />
                <field name="market_sector_id" string="Market niche" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_inh_spacorp" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter" />
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="city" />
                <field name="state_id" />
                <field name="market_id" string="Sale channel" />
                <field name="market_sector_id" string="Market niche" />

            </field>
            <filter name="duedate" position="after">
                <filter
          name="city"
          string="City"
          domain="[]"
          context="{'group_by' : 'city'}"
        />
                <filter
          name="province"
          string="Province"
          domain="[]"
          context="{'group_by' : 'state_id'}"
        />
                <filter
          name="market"
          string="Sale channel"
          domain="[]"
          context="{'group_by' : 'market_id'}"
        />
                <filter
          name="market_sector"
          string="Market niche"
          domain="[]"
          context="{'group_by' : 'market_sector_id'}"
        />
            </filter>
        </field>
    </record>
</odoo>
