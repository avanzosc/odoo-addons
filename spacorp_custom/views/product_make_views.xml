<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_make_view_tree" model="ir.ui.view">
        <field name="model">product.make</field>
        <field name="inherit_id" ref="product_make.product_make_view_tree" />
        <field name="arch" type="xml">
            <field name="print_make_on_out_picking" position="after">
                <field
          name="market_to_print_ids"
          widget="many2many_tags"
          optional="show"
        />
            </field>
        </field>
    </record>

    <record id="product_make_view_form" model="ir.ui.view">
        <field name="model">product.make</field>
        <field name="inherit_id" ref="product_make.product_make_view_form" />
        <field name="arch" type="xml">
            <field name="logo" position="after">
                <field name="market_to_print_ids" widget="many2many_tags" />
            </field>
        </field>
    </record>
</odoo>
