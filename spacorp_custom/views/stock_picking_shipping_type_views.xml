<?xml version="1.0" ?>
<odoo>
    <record id="stock_picking_shipping_type_tree" model="ir.ui.view">
        <field name="name">stock.picking.shipping.type.tree</field>
        <field name="model">stock.picking.shipping.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="stock_picking_shipping_type_form" model="ir.ui.view">
        <field name="name">stock.picking.shipping.type.form</field>
        <field name="model">stock.picking.shipping.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_picking_shipping_type_action" model="ir.actions.act_window">
        <field name="name">Shipping types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking.shipping.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Add a new shipping type.
          </p>
        </field>
    </record>

    <menuitem
    id="menu_stock_picking_shipping_type"
    action="stock_picking_shipping_type_action"
    parent="stock.menu_delivery"
    sequence="5"
  />
</odoo>
