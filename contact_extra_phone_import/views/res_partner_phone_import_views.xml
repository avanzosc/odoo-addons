<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_partner_phone_import_view_tree" model="ir.ui.view">
    <field name="model">res.partner.phone.import</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'done'">
        <field name="name" />
        <field name="file_date" />
        <field name="state" />
        <field name="company_id" groups="base.group_multi_company" />
      </list>
    </field>
  </record>

  <record id="res_partner_phone_import_view_form" model="ir.ui.view">
    <field name="model">res.partner.phone.import</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_import_file"
            string="Import"
            type="object"
            invisible="state not in ('draft','2validate','pass','error')"
          />
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ('2validate','error')"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state not in ('pass','error')"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="o_button_box" name="button_box">
            <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              invisible="not import_line_ids"
              class="o_stat_button"
              icon="fa-bars"
            />
            <button
              type="object"
              name="button_open_res_partner"
              invisible="res_partner_count == 0"
              class="o_stat_button"
              icon="fa-folder-open"
            >
              <field name="res_partner_count" widget="statinfo" />
            </button>
          </div>
          <group>
            <group>
              <field name="filename" />
              <field name="data" filename="filename" />
              <field name="file_date" />
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company" />
            </group>
          </group>
          <notebook>
            <page string="Imported Lines">
              <field name="import_line_ids" />
            </page>
            <page string="Error Log" invisible="log_info == ''">
              <field name="log_info" />
            </page>
            <page string="Help" name="help_page" invisible="state == 'done'">
              <group>
                <div style="margin-top: 4px;">
                  <h3>Help with Excel column names</h3>
                  <p>You must use these column names in order to fill the table:</p>
                  <ul name="tutorial">
                    <li><code>Name</code>: this will fill <b>Contact Name</b></li>
                    <li><code>Code</code>: this will fill <b>Contact Code</b></li>
                    <li><code>Description</code>: this will fill <b>Description</b></li>
                    <li><code>Phone</code>: this will fill <b>Phone</b></li>
                    <li><code>Email</code>: this will fill <b>Email</b></li>
                  </ul>
                </div>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter>
          <field name="message_follower_ids" widget="mail_followers" />
          <field name="activity_ids" widget="mail_activity" />
          <field name="message_ids" widget="mail_thread" />
        </chatter>
      </form>
    </field>
  </record>

  <record id="res_partner_phone_import_view_search" model="ir.ui.view">
    <field name="model">res.partner.phone.import</field>
    <field name="arch" type="xml">
      <search>
        <field name="file_date" />
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <group expand="0" string="Group By">
          <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="res_partner_phone_import_action" model="ir.actions.act_window">
    <field name="name">Import Contact Extra Phone</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.partner.phone.import</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="res_partner_phone_import_view_tree" />
  </record>

  <menuitem
    id="res_partner_phone_import_menu"
    action="res_partner_phone_import_action"
    parent="base_import_wizard.base_import_menu"
    sequence="12"
  />

  <menuitem
    id="res_partner_phone_import_contact_menu"
    action="res_partner_phone_import_action"
    parent="contacts.menu_contacts"
    sequence="17"
  />
</odoo>
