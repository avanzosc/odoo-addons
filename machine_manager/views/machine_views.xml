<?xml version='1.0' encoding='utf-8' ?>
<odoo>
  <!-- Parent Menu on Right Panes -->
  <menuitem
    id="menu_machine_manager"
    name="Machine Manager"
    sequence="85"
    web_icon="machine_manager,static/description/icon.png"
  />

  <menuitem
    id="menu_machine_config"
    name="Configuration"
    parent="menu_machine_manager"
    sequence="2"
  />

  <!-- ========================== Machines ========================== -->

  <record id="machine_form_view" model="ir.ui.view">
    <field name="name">machine.form.view</field>
    <field name="model">machine</field>
    <field name="arch" type="xml">
      <form string="Machine">
        <sheet>
          <group>
            <group string="Machine Details">
              <field name="company_id" invisible="1" />
              <field name="name" />
              <field
                name="product_id"
                domain="[('machine_ok','=',True),('tracking','=','serial')]"
              />
              <field
                name="serial_id"
                context="{'default_product_id': product_id}"
                invisible="not product_id"
              />
            </group>
          </group>
          <notebook>
            <page string="Additional Details">
              <group>
                <group string="Current Details">
                  <field name="status" />
                  <field name="ownership" />
                  <field name="power" />
                  <field name="mac" />
                  <field name="phone" />
                  <field name="ambit" />
                </group>
                <group string="Manufacture Details">
                  <field name="year" />
                  <field name="model" />
                  <field name="model_type_id" />
                </group>
                <group string="Extra Information">
                  <field name="card" />
                  <field name="cardexp" />
                </group>
                <group string="Insurance">
                  <field name="insurance" />
                  <field name="policy" />
                </group>
              </group>
            </page>
            <page name="financial-details" string="Financial Details">
              <group>
                <group string="Enrollment">
                  <field name="enrolldate" />
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="machine_tree_view" model="ir.ui.view">
    <field name="name">machine.tree.view</field>
    <field name="model">machine</field>
    <field name="arch" type="xml">
      <list>
        <field name="product_categ_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="name" optional="show" />
        <field name="company_id" optional="show" />
        <field name="year" optional="show" />
        <field name="model" optional="show" />
        <field name="model_type_id" optional="show" />
        <field name="serial_id" optional="show" />
      </list>
    </field>
  </record>

  <record id="machine_search_view" model="ir.ui.view">
    <field name="name">machine.search.view</field>
    <field name="model">machine</field>
    <field name="arch" type="xml">
      <search string="Search machine">
        <field name="product_id" />
        <field name="serial_id" />
        <field name="model" />
        <field name="model_type_id" />
        <group expand="0" string="Group By">
          <filter
            name="group-model-type"
            string="Model type"
            context="{'group_by' : 'model_type_id'}"
          />
          <filter name="group-model" string="Model" context="{'group_by' : 'model'}" />
          <filter
            name="group-product"
            string="Product"
            context="{'group_by' : 'product_id'}"
          />
          <filter
            name="group-product-categ"
            string="Product category"
            context="{'group_by' : 'product_categ_id'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="machine_form_action" model="ir.actions.act_window">
    <field name="name">Machines</field>
    <field name="res_model">machine</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="menu_machines"
    name="Machines"
    parent="menu_machine_config"
    action="machine_form_action"
    sequence="1"
  />
</odoo>
