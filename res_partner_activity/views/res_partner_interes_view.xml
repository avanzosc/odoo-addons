<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="res_partner_intereses_tree_view" model="ir.ui.view">
    <field name="name">res.partner.intereses.tree.view</field>
    <field name="model">res.partner.interes</field>
    <field name="arch" type="xml">
      <list string="Master of interests" editable="top">
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="res_partner_intereses_action" model="ir.actions.act_window">
    <field name="name">Interests</field>
    <field name="res_model">res.partner.interes</field>
    <field name="view_mode">list</field>
  </record>

  <record
    id="mantenimientos_action_renovacion_mantenimientos_tree"
    model="ir.actions.act_window.view"
  >
    <field name="sequence" eval="1" />
    <field name="act_window_id" ref="res_partner_intereses_action" />
    <field name="view_id" ref="res_partner_intereses_tree_view" />
    <field name="view_mode">list</field>
  </record>
</odoo>
