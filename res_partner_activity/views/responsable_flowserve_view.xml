<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="responsable_flowserve_view_tree" model="ir.ui.view">
    <field name="name">responsable.flowserve.view.tree</field>
    <field name="model">responsable.flowserv</field>
    <field name="arch" type="xml">
      <list editable="top">
        <field name="name" />
        <field name="active" />
        <field name="sequence" />
      </list>
    </field>
  </record>

  <record id="responsable_flowserve_action" model="ir.actions.act_window">
    <field name="name">Flowserve Manager</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">responsable.flowserv</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="responsable_flowserve_view_tree" />
  </record>

  <menuitem
    id="responsable_flowserve_menu"
    action="responsable_flowserve_action"
    parent="contacts.res_partner_menu_config"
    sequence="3"
  />
</odoo>
