<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_partner_form" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[hasclass('o_address_format')]" position="after">
        <field
          name="managing_entity_id"
          invisible="is_company == False"
          string="Managing Entity"
        />
        <field name="schedule" string="Schedule" />
        <field name="what_do_they_do" string="What Do They Do" />
        <field name="interest_id" string="Interest" />
      </xpath>
      <field name="category_id" position="after">
        <field name="principal_activity_id" widget="selection" />
        <field name="principal_activity_water" invisible="1" />
        <field name="principal_activity_industry" invisible="1" />
        <field
          name="water_subactivity_id"
          modifiers="{'invisible': [('principal_activity_water', '=', False)]}"
          widget="selection"
        />
        <field
          name="general_industry_subactivity_id"
          modifiers="{'invisible': [('principal_activity_industry', '=', False)]}"
          widget="selection"
        />
        <field name="flowserve_manager_id" />
      </field>
    </field>
  </record>

  <record id="view_partner_tree" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree" />
    <field name="arch" type="xml">
      <field name="country_id" position="after">
        <field name="principal_activity_id" optional="show" />
        <field name="water_subactivity_id" optional="show" />
        <field name="general_industry_subactivity_id" optional="show" />
        <field name="flowserve_manager_id" optional="show" />
      </field>
      <field name="complete_name" position="after">
        <field name="managing_entity_id" optional="hide" />
      </field>
      <field name="city" position="after">
        <field name="interest_id" string="Interest" optional="hide" />
      </field>
    </field>
  </record>

  <record id="view_res_partner_filter" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="managing_entity_id" />
        <field name="interest_id" />
      </field>
      <field name="user_id" position="after">
        <field name="principal_activity_id" />
        <field name="water_subactivity_id" />
        <field name="general_industry_subactivity_id" />
        <field name="flowserve_manager_id" />
      </field>
      <filter name="group_country" position="after">
        <filter
          name="principal_activity"
          string="Principal Activity"
          context="{'group_by': 'principal_activity_id'}"
        />
        <filter
          name="water_subactivity"
          string="Water Subactivity"
          context="{'group_by': 'water_subactivity_id'}"
        />
        <filter
          name="general_industry_subactivity"
          string="General Industry Subactivity"
          context="{'group_by': 'general_industry_subactivity_id'}"
        />
        <filter
          name="flowserve_manager"
          string="Flowserve Manager"
          context="{'group_by': 'flowserve_manager_id'}"
        />
      </filter>
      <filter name="group_company" position="before">
        <filter
          name="group_managing_entity"
          string="Managing Entity"
          context="{'group_by': 'managing_entity_id'}"
        />
        <filter
          name="group_interest"
          string="Interest"
          context="{'group_by': 'interest_id'}"
        />
      </filter>
    </field>
  </record>

  <record id="action_open_gestora_members" model="ir.actions.act_window">
    <field name="name">Entidades que gestiona</field>
    <field name="res_model">res.partner</field>
    <field name="binding_model_id" ref="model_res_partner" />
    <field name="view_mode">tree</field>
    <field name="target">current</field>
    <field
      name="domain"
    >[('managing_entity_id', 'in', context.get('active_ids'))]</field>
  </record>
</odoo>
