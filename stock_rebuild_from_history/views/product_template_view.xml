<odoo>
    <record id="action_convert_consumable_to_stockable" model="ir.actions.server">
        <field name="name">Convert Stockable and Rebuild Stock</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="state">code</field>
        <field name="code">
            for record in records:
                if record.type == 'consu':
                    env.cr.execute("""
                        UPDATE product_template
                        SET type = 'product'
                        WHERE id = %s
                    """, (record.id,))
                    record.invalidate_cache(['type'])
                    record.action_rebuild_stock()
        </field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_type">action</field>
    </record>
</odoo>
