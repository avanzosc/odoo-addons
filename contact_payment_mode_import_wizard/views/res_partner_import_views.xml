<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="res_partner_payment_import_view_tree" model="ir.ui.view">
    <field name="model">res.partner.payment.import</field>
    <field name="arch" type="xml">
      <list decoration-muted="state == 'done'" decoration-bf="state == 'pass'">
        <field name="name" />
        <field name="file_date" />
        <field name="import_type" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="state" />
      </list>
    </field>
  </record>

  <record id="res_partner_payment_import_view_form" model="ir.ui.view">
    <field name="model">res.partner.payment.import</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="action_import_file"
            string="Import"
            type="object"
            invisible="state == 'done'"
          />
          <button
            name="action_validate"
            string="Validate"
            type="object"
            invisible="state not in ('2validate', 'error', 'pass')"
          />
          <button
            name="action_process"
            string="Process"
            type="object"
            invisible="state != 'pass'"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              string="Import Lines"
              type="object"
              name="button_open_import_line"
              invisible="not import_line_ids"
              class="oe_stat_button"
              icon="fa-bars"
            />
            <button
              type="object"
              name="button_open_partner"
              invisible="not partner_count"
              class="oe_stat_button"
              icon="fa-folder-open"
            >
              <field name="partner_count" widget="statinfo" />
            </button>
          </div>
          <group>
            <group>
              <field name="filename" invisible="1" readonly="state == 'done'" />
              <field name="data" filename="filename" readonly="state == 'done'" />
              <field name="file_date" readonly="state == 'done'" />
            </group>
            <group>
              <field name="import_type" readonly="state == 'done'" />
              <field
                name="company_id"
                groups="base.group_multi_company"
                options="{'no_create': True}"
                readonly="state == 'done'"
              />
            </group>
          </group>
          <notebook>
            <page string="Imported Lines">
              <field
                name="import_line_ids"
                context="{'list_view_ref': 'contact_payment_mode_import_wizard.res_partner_payment_import_line_base_view_tree'}"
              />
            </page>
            <page string="Error Log" invisible="not log_info">
              <field name="log_info" />
            </page>
            <page string="Help" name="help_page" invisible="state == 'done'">
              <div style="margin-top: 4px;">
                <h3>Help with Excel column names</h3>
                <p>You must use this column names in order to fill the table:</p>
                <ul name="tutorial">
                  <li><code t-translation="off">Name</code>: this will fill <b
                  >Contact Name</b></li>
                  <li><code t-translation="off">Code</code>: this will fill <b
                  >Contact Code</b></li>
                  <li><code t-translation="off">PaymentMode</code>: this will fill <b
                  >Payment Mode</b></li>
                  <li><code t-translation="off">PaymentTerm</code>: this will fill <b
                  >Payment Term</b></li>
                  <li><code
                    t-translation="off"
                  >AccountFiscalPosition</code>: this will fill <b
                  >Account Fiscal Position</b></li>
                </ul>
              </div>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>

  <record id="res_partner_payment_import_view_search" model="ir.ui.view">
    <field name="model">res.partner.payment.import</field>
    <field name="arch" type="xml">
      <search>
        <field name="file_date" />
        <filter name="pending" string="Pending" domain="[('state', '!=', 'done')]" />
        <filter name="finished" string="Done" domain="[('state', '=', 'done')]" />
        <filter name="errored" string="Error" domain="[('state', '=', 'error')]" />
        <group expand="0" string="Group By">
          <filter
            string="Status"
            name="state_group"
            domain="[]"
            context="{'group_by':'state'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="res_partner_payment_import_action" model="ir.actions.act_window">
    <field name="name">Import Contact Payments</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.partner.payment.import</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="res_partner_payment_import_view_tree" />
  </record>

  <menuitem
    id="res_partner_payment_import_menu"
    action="res_partner_payment_import_action"
    parent="base_import_wizard.base_import_menu"
    sequence="10"
  />

  <menuitem
    id="contacts_payment_import_menu"
    action="res_partner_payment_import_action"
    parent="contacts.menu_contacts"
    sequence="15"
  />
</odoo>
