<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_form_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form_editable" />
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
                <group name="lot-dates">
                    <group>
                        <field name="expiration_date" readonly="1" />
                        <field name="removal_date" readonly="1" />
                    </group>
                    <group>
                        <field name="use_date" readonly="1" />
                        <field name="alert_date" readonly="1" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="expiration_date" optional="hide" />
                <field name="removal_date" optional="hide" />
                <field name="use_date" optional="hide" />
                <field name="alert_date" optional="hide" />
            </field>
        </field>
    </record>

    <record id="quant_search_view" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <field name="inventory_date">
                <field name="expiration_date" />
                <field name="removal_date" />
                <field name="use_date" />
                <field name="alert_date" />
            </field>
            <filter name="company" position="after">
                <filter
          string="Expiration Date"
          name="groupby_expiration_date"
          domain="[]"
          context="{'group_by': 'expiration_date'}"
        />
                <filter
          string="Removal Date"
          name="groupby_removal_date"
          domain="[]"
          context="{'group_by': 'removal_date'}"
        />
                <filter
          string="Best before Date"
          name="groupby_use_date"
          domain="[]"
          context="{'group_by': 'use_date'}"
        />
                <filter
          string="Alert Date"
          name="groupby_alert_date"
          domain="[]"
          context="{'group_by': 'alert_date'}"
        />
            </filter>
        </field>
    </record>
</odoo>
