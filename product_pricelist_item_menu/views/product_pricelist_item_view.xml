<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_pricelist_item_tree_view" model="ir.ui.view">
    <field name="model">product.pricelist.item</field>
    <field name="inherit_id" ref="product.product_pricelist_item_tree_view" />
    <field name="arch" type="xml">
      <list position="attributes">
        <attribute
          name="decoration-muted"
        >(date_start and date_start &gt; current_date) or (date_end and date_end &lt; current_date)</attribute>
        <!--<attribute name="decoration-danger">(product_tmpl_id and not product_tmpl_id.active) or (product_id and not product_id.active)</attribute>-->
      </list>
      <field name="date_end" position="after">
        <field name="base" optional="hide" />
        <field name="price_discount" optional="hide" />
        <field name="applied_on" optional="show" />
        <field name="compute_price" optional="show" />
      </field>
    </field>
  </record>

  <record id="product_pricelist_item_view_search" model="ir.ui.view">
    <field name="model">product.pricelist.item</field>
    <field name="inherit_id" ref="product.product_pricelist_item_view_search" />
    <field name="arch" type="xml">
      <field name="pricelist_id" position="after">
        <separator />
        <field name="product_id" />
        <field name="product_tmpl_id" />
        <field name="categ_id" />
        <separator />
        <field name="base" />
      </field>
      <filter name="visible" position="after">
        <separator />
        <filter
          string="Active Products"
          name="active_products"
          domain="[
            '&amp;',
            '|', ('product_tmpl_id', '=', None), ('product_tmpl_id.active', '=', True),
            '|', ('product_id', '=', None), ('product_id.active', '=', True),
          ]"
          context="{}"
        />
        <separator />
        <filter
          name="fixed_price"
          string="Fixed Price"
          domain="[('compute_price', '=', 'fixed')]"
        />
        <filter
          name="percentage"
          string="Percentage"
          domain="[('compute_price', '=', 'percentage')]"
        />
        <filter
          name="formula"
          string="Formula"
          domain="[('compute_price', '=', 'formula')]"
        />
      </filter>
      <filter name="groupby_product_variant" position="after">
        <filter
          string="Product Category"
          name="groupby_category"
          domain="[]"
          context="{'group_by':'categ_id'}"
        />
      </filter>
      <filter name="groupby_vendor" position="after">
        <separator />
        <filter
          string="Based on"
          name="groupby_base"
          domain="[]"
          context="{'group_by':'base'}"
        />
        <filter
          string="Apply On"
          name="groupby_applied"
          domain="[]"
          context="{'group_by':'applied_on'}"
        />
        <filter
          string="Compute Price"
          name="groupby_compute_price"
          domain="[]"
          context="{'group_by':'compute_price'}"
        />
        <filter
          string="Other Pricelist"
          name="groupby_base_pricelist"
          domain="[]"
          context="{'group_by':'base_pricelist_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
