<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_purchaseorder_document_inh_date_ready_forwarded"
    inherit_id="purchase.report_purchaseorder_document"
  >
    <xpath expr="//div[contains(@class,'page')]" position="inside">
      <div class="row mb-3" style="margin-bottom: 12px;">
        <div t-if="o.date_ready" class="col-3">
          <strong>Date Ready:</strong>
          <p t-field="o.date_ready" class="m-0" />
        </div>
        <div t-if="o.date_forwarded" class="col-3">
          <strong>Date Forwarded:</strong>
          <p t-field="o.date_forwarded" class="m-0" />
        </div>
        <div t-if="o.date_delivery" class="col-3">
          <strong>Delivery Date:</strong>
          <p t-field="o.date_delivery" class="m-0" />
        </div>
        <div t-if="o.date_arrival" class="col-3">
          <strong>Arrival Date:</strong>
          <p t-field="o.date_arrival" class="m-0" />
        </div>
      </div>
    </xpath>
  </template>
</odoo>
