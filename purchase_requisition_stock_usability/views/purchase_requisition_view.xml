<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_purchase_requisition_form" model="ir.ui.view">
    <field name="name">purchase.requisition.form.stock.usability</field>
    <field name="model">purchase.requisition</field>
    <field
      name="inherit_id"
      ref="purchase_requisition.view_purchase_requisition_form"
    />
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <field name="picking_type_id" position="attributes">
        <attribute name="domain">[('code', '=', 'incoming')]</attribute>
      </field>
    </field>
  </record>
</odoo>
