<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">product.template.form.additional.info</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <page name="general_information" position="inside">
        <group
          name="website_sale_additional_info"
          string="eCommerce Additional Information"
        >
          <group>
            <field name="website_assorted_stains" />
            <field name="website_bottom_ply" />
            <field name="website_top_ply" />
            <field name="website_full_dip" />
          </group>
          <group>
            <field name="website_wheel_wells" />
            <field name="website_raised_ink" />
            <field name="website_foil_ink" />
            <field name="website_matte_finish" />
          </group>
        </group>
      </page>
    </field>
  </record>
</odoo>
