<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_quant_tree_inventory_editable_at_date" model="ir.ui.view">
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
    <field name="arch" type="xml">
      <field name="quantity" position="attributes">
        <attribute
          name="column_invisible"
        >context.get('inventory_is_at_date')</attribute>
      </field>
      <field name="quantity" position="after">
        <field
          name="inventory_at_date_qty"
          string="Qty at Inventory Date"
          optional="show"
          readonly="1"
          column_invisible="not context.get('inventory_is_at_date')"
        />
      </field>
    </field>
  </record>
</odoo>
