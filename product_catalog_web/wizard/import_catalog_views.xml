<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="import_catalog_web_view_form" model="ir.ui.view">
    <field name="name">import.catalog.web.view.form</field>
    <field name="model">import.catalog.web</field>
    <field name="arch" type="xml">
      <form string="Import products to catalog">
        <group>
          <field name="file_bin" filename="filename" />
          <field name="replace" />
        </group>
        <footer>
          <button
            name="action_import"
            string="Import"
            type="object"
            class="btn-primary"
          />
          <button string="Cancel" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="import_catalog_web_action" model="ir.actions.act_window">
    <field name="name">Import products</field>
    <field name="res_model">import.catalog.web</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
