<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
    id="report_purchaseorder_document_inherit"
    inherit_id="purchase.report_purchaseorder_document"
  >

        <xpath expr="//h2" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//h2[2]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//h2[3]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//h2" position="after">
            <h2
        style="text-align: right;"
        t-if="o.state in ['draft', 'sent', 'to approve']"
      >Request for Quotation #<span t-field="o.name" />
            </h2>
            <h2
        style="text-align: right;"
        t-if="o.state in ['purchase', 'done']"
      >Purchase Order #<span t-field="o.name" />
            </h2>
            <h2
        style="text-align: right;"
        t-if="o.state == 'cancel'"
      >Cancelled Purchase Order #<span t-field="o.name" />
            </h2>
        </xpath>

        <xpath expr="//div[@id='informations']/div[1]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//div[@id='informations']/div[3]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//div[@id='informations']/div[4]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

    </template>
</odoo>
