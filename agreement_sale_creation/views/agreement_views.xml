<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="agreement_form" model="ir.ui.view">
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement.agreement_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
          class="oe_stat_button"
          type="action"
          name="%(sale.action_quotations_with_onboarding)d"
          context="{'search_default_agreement_id': active_id, 'default_agreement_id': active_id, 'default_partner_id': partner_id}"
          attrs="{'invisible': [('domain', '!=', 'sale')]}"
          icon="fa-usd"
        >
                    <field string="Sale Orders" name="sale_count" widget="statinfo" />
                </button>
                <button
          class="oe_stat_button"
          type="action"
          name="%(stock.action_picking_tree_all)d"
          context="{'search_default_agreement_id': active_id, 'default_agreement_id': active_id, 'default_partner_id': partner_id}"
          attrs="{'invisible': [('domain', '!=', 'sale')]}"
          icon="fa-truck"
        >
                    <field string="Transfers" name="picking_count" widget="statinfo" />
                </button>
            </div>
            <field name="domain" position="after">
                <field
          name="sale_type_id"
          attrs="{'invisible': [('domain', '!=', 'sale')]}"
        />
                <field
          name="sale_tmpl_id"
          attrs="{'invisible': [('domain', '!=', 'sale')]}"
        />
            </field>
        </field>
    </record>
</odoo>
