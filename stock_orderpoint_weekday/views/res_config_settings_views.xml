<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='warehouse_setting_container']" position="inside">
                 <div
          class="col-12 col-lg-6 o_setting_box"
          id="update_orderpoint_date"
          title="When setting an specific date it will add a year to this date automatically"
        >
                    <div class="o_setting_left_pane">
                        <field name="update_weekday_orderpoint" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="update_weekday_orderpoint" />
                        <span
              class="fa fa-lg fa-building-o"
              title="Values set here are company-specific."
              groups="base.group_multi_company"
            />
                        <div class="text-muted">
                            When an specific date is used to calculate the required quantity of product, date will automatically updated for next year.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
