#. module: sale_product_attribute_hidden
#. odoo-python
#: code:addons/sale_product_attribute_hidden/models/product_attribute.py:0
msgid ""
"Attribute %(attribute)s creates variants, so it cannot be hidden in the "
"product configuration."
msgstr ""
"El atributo %(attribute)s crea variantes, así que no se puede ocultar en la "
"configuración del producto."

#. module: sale_product_attribute_hidden
#: model:ir.model.fields,field_description:sale_product_attribute_hidden.field_product_attribute__hide_in_configuration
msgid "Hide in product configuration"
msgstr "Ocultar en la configuración del producto"

#. module: sale_product_attribute_hidden
#: model:ir.model,name:sale_product_attribute_hidden.model_product_template
msgid "Product"
msgstr "Producto"

#. module: sale_product_attribute_hidden
#: model:ir.model,name:sale_product_attribute_hidden.model_product_attribute
msgid "Product Attribute"
msgstr "Atributo de producto"

#. module: sale_product_attribute_hidden
#: model:ir.model,name:sale_product_attribute_hidden.model_product_template_attribute_line
msgid "Product Template Attribute Line"
msgstr "Línea de atributo de la plantilla de producto"

#. module: sale_product_attribute_hidden
#: model:ir.model.fields,help:sale_product_attribute_hidden.field_product_attribute__hide_in_configuration
msgid ""
"The attribute is not used in the variant grid of sales and purchases nor in "
"the product configurator, and it is not shown on the product page of the "
"online shop. Products can still be filtered by it. Only for attributes that "
"never create variants."
msgstr ""
"El atributo no se usa en la tabla de variantes de ventas y compras ni en el "
"configurador de producto, y no se muestra en la página del producto de la "
"tienda online. Los productos se pueden seguir filtrando por él. Solo para "
"atributos que nunca crean variantes."
