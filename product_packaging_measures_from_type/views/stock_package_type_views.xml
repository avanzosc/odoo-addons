<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_package_type_form" model="ir.ui.view">
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_form" />
        <field name="arch" type="xml">
            <div name="max_weight" position="after">
                <label for="qty_per_layer" />
                <div class="o_row" name="qty_per_layer">
                    <field name="qty_per_layer" />
                </div>
            </div>
        </field>
    </record>

    <record id="stock_package_type_tree" model="ir.ui.view">
        <field name="model">stock.package.type</field>
        <field name="inherit_id" ref="stock.stock_package_type_tree" />
        <field name="arch" type="xml">
            <field name="max_weight" position="after">
                <field name="qty_per_layer" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
