#. module: product_packaging_measures_from_type
#: model:ir.model.fields,help:product_packaging_measures_from_type.field_stock_package_type__qty_per_layer
msgid ""
"Number of packages of this type that fit in a single layer when stacked on a"
" pallet. Used to estimate the height of a pallet from the number of inner "
"packages it contains."
msgstr ""
"Nombre de paquets d'aquest tipus que caben en una sola capa en apilar-los "
"sobre un palet. S'utilitza per estimar l'alçada d'un palet a partir del "
"nombre de paquets interiors que conté."

