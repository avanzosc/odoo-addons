<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_create_historical_risk" model="ir.actions.server">
        <field name="name">Create Historical Risk</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records._create_historical_risk()
        </field>
    </record>

    <record id="ir_cron_create_historical_risk" model="ir.cron">
        <field name="name">Create Historical Risk</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">
            model.cron_create_historical_risk()
        </field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
