<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <field name="client_order_ref" position="after">
        <field name="global_origin_initial" />
        <field name="global_origin" />
      </field>
    </field>
  </record>

  <record id="action_recompute_global_origin" model="ir.actions.server">
    <field name="name">Recompute Global Origin</field>
    <field name="model_id" ref="sale.model_sale_order" />
    <field name="binding_model_id" ref="sale.model_sale_order" />
    <field name="binding_view_types">list,form</field>
    <field name="groups_id" eval="[(4, ref('base.group_system'))]" />
    <field name="state">code</field>
    <field name="code">records._recompute_global_origin()</field>
  </record>
</odoo>
